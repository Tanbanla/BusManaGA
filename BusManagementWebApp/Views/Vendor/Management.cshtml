@section Scripts {
    @if (TempData["VendorSuccess"] is string successMessage)
    {
        <script>window.AppCommon && AppCommon.success(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));</script>
    }
    @if (TempData["VendorError"] is string errorMessage)
    {
        <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));</script>
    }

    <script>
        (function () {
            var $chkAll = $('#chkAllVendors');
            var $rowChecks = $('.js-vendor-check');
            var $btnDelete = $('#btnDeleteSelected');
            var $deletedIdsContainer = $('#deletedIdsContainer');
            var $gridForm = $('#vendorGridForm');
            var $deleteOneForm = $('#deleteOneForm');
            var $deleteOneId = $('#deleteOneId');

            function refreshDeleteButtonState() {
                var selected = $('.js-vendor-check:checked').length;
                $btnDelete.toggleClass('d-none', selected === 0);

                var total = $rowChecks.length;
                $chkAll.prop('checked', total > 0 && selected === total);
                $chkAll.prop('indeterminate', selected > 0 && selected < total);
            }

            $chkAll.on('change', function () {
                var checked = $(this).is(':checked');
                $rowChecks.prop('checked', checked);
                refreshDeleteButtonState();
            });

            $(document).on('change', '.js-vendor-check', refreshDeleteButtonState);

            $btnDelete.on('click', async function () {
                var selected = $('.js-vendor-check:checked');
                if (!selected.length) {
                    window.AppCommon && AppCommon.warning('Vui lòng chọn ít nhất 1 nhà xe.');
                    return;
                }

                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({
                        title: 'Xóa nhiều nhà xe',
                        message: 'Bạn có chắc chắn muốn xóa các nhà xe đã chọn?',
                        okText: 'Đồng ý',
                        cancelText: 'Hủy',
                        okVariant: 'danger'
                    });
                } else {
                    ok = confirm('Bạn có chắc chắn muốn xóa các nhà xe đã chọn?');
                }

                if (!ok) return;

                $deletedIdsContainer.empty();
                selected.each(function () {
                    $deletedIdsContainer.append('<input type="hidden" name="deletedIds" value="' + $(this).val() + '" />');
                });

                $gridForm.trigger('submit');
            });

            $(document).on('click', '.js-delete-one', async function () {
                var id = $(this).data('id');
                if (!id) return;

                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({
                        title: 'Xóa nhà xe',
                        message: 'Bạn có chắc chắn muốn xóa nhà xe này?',
                        okText: 'Đồng ý',
                        cancelText: 'Hủy',
                        okVariant: 'danger'
                    });
                } else {
                    ok = confirm('Bạn có chắc chắn muốn xóa nhà xe này?');
                }

                if (!ok) return;

                $deleteOneId.val(id);
                $deleteOneForm.trigger('submit');
            });

            function applyVendorBusFilter($modal, filterValue) {
                var normalized = (filterValue || 'all').toString();
                var visibleCount = 0;

                $modal.find('.js-bus-filter-btn').removeClass('active btn-primary').addClass('btn-outline-primary');
                $modal.find('.js-bus-filter-btn[data-filter="' + normalized + '"]')
                    .removeClass('btn-outline-primary')
                    .addClass('active btn-primary');

                $modal.find('.js-vendor-bus-row').each(function () {
                    var rowCapacity = ($(this).data('capacity') || '').toString();
                    var isVisible = normalized === 'all' || rowCapacity === normalized;
                    $(this).toggle(isVisible);
                    if (isVisible) visibleCount++;
                });

                $modal.find('.js-bus-empty').toggleClass('d-none', visibleCount > 0);
            }

            $(document).on('click', '.js-open-vendor-buses', function () {
                var vendorId = $(this).data('vendor-id');
                if (!vendorId) return;

                var filter = ($(this).data('filter') || 'all').toString();
                var $modal = $('#vendorBusModal-' + vendorId);
                if (!$modal.length) return;

                $modal.data('open-filter', filter);
                $modal.modal('show');
            });

            $(document).on('click', '.js-open-vendor-drivers', function () {
                var vendorId = $(this).data('vendor-id');
                if (!vendorId) return;

                var $modal = $('#vendorDriverModal-' + vendorId);
                if (!$modal.length) return;
                $modal.modal('show');
            });

            $(document).on('shown.bs.modal', '.vendor-bus-modal', function () {
                var $modal = $(this);
                var filter = ($modal.data('open-filter') || 'all').toString();
                applyVendorBusFilter($modal, filter);
            });

            $(document).on('click', '.vendor-bus-modal .js-bus-filter-btn', function () {
                var $modal = $(this).closest('.vendor-bus-modal');
                var filter = ($(this).data('filter') || 'all').toString();
                applyVendorBusFilter($modal, filter);
            });

            async function confirmDelete(message) {
                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({
                        title: 'Xác nhận xóa',
                        message: message,
                        okText: 'Đồng ý',
                        cancelText: 'Hủy',
                        okVariant: 'danger'
                    });
                } else {
                    ok = confirm(message);
                }
                return ok;
            }

            $(document).on('click', '.js-delete-bus', async function () {
                var formId = $(this).data('form-id');
                if (!formId) return;
                var ok = await confirmDelete('Bạn có chắc chắn muốn xóa xe này?');
                if (!ok) return;
                $('#' + formId).trigger('submit');
            });

            $(document).on('click', '.js-delete-driver', async function () {
                var formId = $(this).data('form-id');
                if (!formId) return;
                var ok = await confirmDelete('Bạn có chắc chắn muốn xóa tài xế này?');
                if (!ok) return;
                $('#' + formId).trigger('submit');
            });

            refreshDeleteButtonState();
        })();
    </script>
}
