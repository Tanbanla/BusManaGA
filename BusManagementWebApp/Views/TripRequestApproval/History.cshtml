@{
    var vm = ViewData.Model as BusManagement.ViewModels.TripRequest.TripRequestApprovalHistoryPageViewModel;
    ViewData["Title"] = "Lịch sử xử lý đơn xe công tác";
}

<style>
    .history-card { border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; box-shadow: 0 10px 24px rgba(15, 23, 42, .05); }

    #approvalHistoryModal .modal-body {
        overflow-y: auto;
    }

</style>

<div class="history-card p-3 p-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h5 class="m-0">Lịch sử xử lý đơn #@(vm?.RequestId)</h5>
        <a class="btn btn-outline-secondary" href="javascript:void(0)" onclick="window.history.back(); return false;">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    @await Html.PartialAsync("_HistoryContent", vm)
</div>
