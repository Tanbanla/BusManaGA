    <script>
        document.addEventListener('DOMContentLoaded', () => {

            document.querySelectorAll('.dragable-modal').forEach(modal => {
              const dialog = modal.querySelector('.modal-dialog');
              const header = modal.querySelector('.modal-header');
              if (!dialog || !header) return;

              let isDragging = false;
              let startX = 0, startY = 0;
              let currentX = 0, currentY = 0;
              let pendingX = 0, pendingY = 0;
              let rafId = null;

              // Cursor kéo thả khi hover vào header
              header.style.cursor = 'grab';

              function applyTransform() {
                dialog.style.transform = `translate(${pendingX}px, ${pendingY}px)`;
                rafId = null;
              }

              function scheduleUpdate() {
                if (rafId === null) {
                  rafId = requestAnimationFrame(applyTransform);
                }
              }

              function dragStart(e) {
                    // Bỏ qua nếu bấm vào nút đóng hoặc phần tử tương tác khác trong header
                    if (e.target.closest('.btn-close, button, a, input, select, textarea')) {
                    return;
                    }

                    if (e.pointerType === 'mouse' && e.button !== 0) return;

                    isDragging = true;
                    startX = e.clientX - currentX;
                    startY = e.clientY - currentY;

                    header.setPointerCapture(e.pointerId);
                    header.style.cursor = 'grabbing';
                    document.body.style.userSelect = 'none';
                }

              function dragMove(e) {
                if (!isDragging) return;
                e.preventDefault();

                currentX = e.clientX - startX;
                currentY = e.clientY - startY;

                pendingX = currentX;
                pendingY = currentY;
                scheduleUpdate();
              }

              function dragEnd(e) {
                if (!isDragging) return;
                isDragging = false;

                if (e && e.pointerId !== undefined) {
                  try { header.releasePointerCapture(e.pointerId); } catch (_) {}
                }

                header.style.cursor = 'grab';
                document.body.style.userSelect = '';
              }

              header.addEventListener('pointerdown', dragStart);
              header.addEventListener('pointermove', dragMove, { passive: false });
              header.addEventListener('pointerup', dragEnd);
              header.addEventListener('pointercancel', dragEnd);

              /* Reset khi đóng modal (tuỳ chọn) */
              modal.addEventListener('hidden.bs.modal', () => {
                currentX = currentY = 0;
                pendingX = pendingY = 0;
                if (rafId !== null) {
                  cancelAnimationFrame(rafId);
                  rafId = null;
                }
                dialog.style.transform = '';
              });
            });
        });
    </script>

    <script>
        (function () {
            window.initSharedSelectPicker = function (scope) {
                if (!window.jQuery || typeof window.jQuery.fn.selectpicker !== 'function') return;

                var $scope = scope ? window.jQuery(scope) : window.jQuery(document);
                var $pickers = $scope.find('.selectpicker');
                if (!$pickers.length) return;

                $pickers.each(function () {
                    var $el = window.jQuery(this);
                    var $modal = $el.closest('.modal');
                    var explicitContainer = $el.attr('data-container');
                    var options = {};

                    if (explicitContainer) {
                        options.container = explicitContainer;
                    } else if ($modal.length) {
                        var modalId = $modal.attr('id');
                        if (modalId) {
                            options.container = '#' + modalId;
                        }
                    }

                    var initializedFlag = $el.data('spInitialized') === true;
                    var hasPluginInstance = !!$el.data('selectpicker');

                    if (!initializedFlag) {
                        try {
                            // cleanup stale bootstrap-select wrappers before first init
                            $el.siblings('.bootstrap-select').remove();
                        } catch (e) { }

                        $el.selectpicker(options);
                        $el.data('spInitialized', true);
                        return;
                    }

                    if (!hasPluginInstance) {
                        try { $el.selectpicker('destroy'); } catch (e) { }
                        try { $el.siblings('.bootstrap-select').remove(); } catch (e) { }
                        $el.selectpicker(options);
                        return;
                    }

                    $el.selectpicker('refresh');
                });
            };

            window.jQuery(function () {
                window.initSharedSelectPicker(document);
            });
        })();

        // global clock and notifications
        (function () {
            var $preview = null;
            var hideTimer = null;

            function getAvatarText(name) {
                var normalized = (name || '').toString().trim();
                if (!normalized) return 'U';
                var parts = normalized.split(/\s+/).filter(Boolean);
                if (parts.length === 1) return parts[0].slice(0, 1).toUpperCase();
                return (parts[0].slice(0, 1) + parts[parts.length - 1].slice(0, 1)).toUpperCase();
            }

            function escapeHtml(s) {
                return (s || '').toString().replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
            }

            function setPreviewPosition(pageX, pageY) {
                if (!$preview || !$preview.length) return;
                var gap = 14;
                var left = pageX + gap;
                var top = pageY + gap;
                var maxLeft = window.innerWidth - $preview.outerWidth() - 10;
                var maxTop = window.innerHeight - $preview.outerHeight() - 10;
                if (left > maxLeft) left = pageX - $preview.outerWidth() - gap;
                if (top > maxTop) top = pageY - $preview.outerHeight() - gap;
                $preview.css({ left: Math.max(8, left) + 'px', top: Math.max(8, top) + 'px' });
            }

            function showAvatarPreview($target, ev) {
                if (!$preview || !$preview.length) return;
                var name = $target.data('user-name') || $target.attr('alt') || '';
                var code = $target.data('user-code') || '';
                var team = $target.data('user-team') || '';
                var avatar = $target.data('avatar-url') || $target.attr('src') || '';

                $('#avatarHoverPreviewName').text(name || 'Unknown user');
                $('#avatarHoverPreviewCode').text(code ? ('Mã NV: ' + code) : '');
                $('#avatarHoverPreviewTeam').text(team ? ('Team: ' + team) : '');

                var $img = $('#avatarHoverPreviewImage');
                if (avatar) {
                    $img.html('<img src="' + escapeHtml(avatar) + '" alt="avatar" class="preview-avatar" />');
                } else {
                    $img.text(getAvatarText(name));
                }

                $preview.addClass('show').attr('aria-hidden', 'false');
                setPreviewPosition(ev.clientX || 0, ev.clientY || 0);
            }

            function hideAvatarPreview() {
                if (!$preview || !$preview.length) return;
                $preview.removeClass('show').attr('aria-hidden', 'true');
            }

            $(function () {
                $preview = $('#avatarHoverPreview');

                $(document).on('mouseenter', '.avatar-preview-trigger', function (ev) {
                    if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
                    showAvatarPreview($(this), ev);
                });

                $(document).on('mousemove', '.avatar-preview-trigger', function (ev) {
                    setPreviewPosition(ev.clientX || 0, ev.clientY || 0);
                });

                $(document).on('mouseleave', '.avatar-preview-trigger', function () {
                    hideTimer = setTimeout(hideAvatarPreview, 40);
                });

                $(window).on('scroll resize', function () {
                    hideAvatarPreview();
                });
            });
        })();

        (function () {
            function formatTwo(n) { return (n < 10 ? '0' + n : n); }
            function updateClock() {
                var d = new Date();
                var dd = ('0' + d.getDate()).slice(-2);
                var mm = ('0' + (d.getMonth() + 1)).slice(-2);
                var yyyy = d.getFullYear();
                var time = formatTwo(d.getHours()) + ':' + formatTwo(d.getMinutes()) + ':' + formatTwo(d.getSeconds());
                var s = dd + '/' + mm + '/' + yyyy + ' ' + time;
                var el = document.getElementById('globalClock');
                if (el) el.textContent = s;
            }

            // sample notifications store (could be loaded from server)
            // var notifications = [
            //     { id: 1, text: '', time: '1h' },
            //     { id: 2, text: '', time: '2h' },
            //     { id: 3, text: '', time: '2h' },
            //     { id: 4, text: '', time: '5h' },
            //     { id: 5, text: '', time: '6h' }
            // ];

            // function renderNotifications() {
            //     var list = document.getElementById('notifList');
            //     var badge = document.getElementById('notifBadge');
            //     if (!list || !badge) return;
            //     list.innerHTML = '';
            //     if (!notifications.length) {
            //         list.innerHTML = '<div class="list-group-item small text-muted text-center">No notification</div>';
            //         badge.classList.add('d-none');
            //         badge.textContent = '0';
            //         return;
            //     }
            //     notifications.forEach(function (n) {
            //         var item = document.createElement('div');
            //         item.className = 'list-group-item list-group-item-action small';
            //         item.innerHTML = '<div class="fw-semibold">' + escapeHtml(n.text) + '</div><div class="text-muted small">' + escapeHtml(n.time) + '</div>';
            //         list.appendChild(item);
            //     });
            //     badge.classList.remove('d-none');
            //     badge.textContent = notifications.length;
            // }

            // function escapeHtml(s){ return (s||'').toString().replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;'); }

            document.addEventListener('DOMContentLoaded', function () {
                updateClock();
                setInterval(updateClock, 1000);
                //renderNotifications();

                // var markBtn = document.getElementById('markAllRead');
                // if (markBtn) {
                //     markBtn.addEventListener('click', function (e) {
                //         e.preventDefault();
                //         notifications = [];
                //         renderNotifications();
                //     });
                // }
            });
        })();
        (function () {
            var pageAnim = null;
            var animLoaded = false;
            var MIN_DELAY = 1500; // ms before navigation
            //var _navPersist = false;

            function _loadAnim() {
                if (animLoaded) return;
                if (typeof lottie === 'undefined') return;
                try {
                    pageAnim = lottie.loadAnimation({
                        container: document.getElementById('pageLoaderAnim'),
                        renderer: 'svg',
                        loop: true,
                        autoplay: true,
                        path: '/lotties/blue_bus_loading.json'
                    });
                    pageAnim.setSpeed(2);
                    animLoaded = true;
                } catch (e) {
                    console.warn('Lottie load failed', e);
                }
            }

            function _showOverlay() {
                var $el = $('#pageLoader');
                $el.removeClass('d-none hidden').attr('aria-hidden', 'false');
                // ensure repaint
                $el[0].offsetHeight;
                $('body').addClass('is-loading');
                _loadAnim();
            }

            function _hideOverlay() {
                var $el = $('#pageLoader');
                $el.addClass('hidden');
                $('body').removeClass('is-loading');
                setTimeout(function () {
                    $el.addClass('d-none');
                    $el.removeClass('hidden');
                }, 380);
            }

            window.showLoading = function (persistToNextPage) {
                console.log('show loading is called')
                if (persistToNextPage) {
                    try { sessionStorage.setItem('showLoaderOnNextPage', '1'); } catch (e) { }
                }
                // if navigation persisted the loader and page initialization already showed it,
                // ignore the first showLoading call from page scripts to prevent double-count/flicker
                // if (_navPersist) {
                //     _navPersist = false;
                //     return;
                // }
                _showOverlay();
            };

            window.hideLoading = function () {
                try { sessionStorage.removeItem('showLoaderOnNextPage'); } catch (e) {}
                _hideOverlay();
            };

            // intercept internal link clicks to show loader, delay navigation
            $(document).on('click', 'a[href]:not([target="_blank"])', function (e) {
                try {
                    var $a = $(this);
                    var href = $a.attr('href') || '';
                    if (!href) return;
                    if (href.indexOf('#') === 0 || href.indexOf('javascript:') === 0 || href.indexOf('mailto:') === 0) return;
                    if ($a.data('bsToggle') || $a.attr('data-bs-toggle')) return; // bootstrap toggles
                    if ($a.is('[data-no-loader]')) return;

                    var url = new URL(href, window.location.href);
                    if (url.origin !== window.location.origin) return; // external

                    e.preventDefault();
                    // show loader and persist flag for next page so new page can keep it during render
                    window.showLoading(true);
                    setTimeout(function () {
                        window.location.href = url.href;
                    }, MIN_DELAY);
                } catch (err) {
                    // fallback: do nothing
                }
            });

            // opt-in only: show loader only when form or submit button has `show-loading` / `data-show-loading`
            $(document).on('submit', 'form', function () {
                var $f = $(this);
                var shouldShow = $f.is('[show-loading],[data-show-loading]');
                if (!shouldShow) return;
                window.showLoading(false);
            });

            // Avoid showing loader on generic click of submit buttons because
            // client-side handlers can cancel submit (return false), which causes
            // loader to stay visible without navigation. Use `submit` event only.

            // on page load, if navigation set the flag, keep loader visible until window load then hide with fade
            // $(function () {
            //     var showOnLoad = false;
            //     try { showOnLoad = sessionStorage.getItem('showLoaderOnNextPage') === '1'; } catch (e) { }
            //     if (showOnLoad) {
            //         // ensure overlay visible immediately
            //         _showOverlay();
            //         // remove flag so subsequent reloads don't keep showing
            //         try { sessionStorage.removeItem('showLoaderOnNextPage'); } catch (e) { }

            //         // auto-hide guard: if window.load doesn't fire (or takes too long), hide after MAX_AUTO_HIDE
            //         var MAX_AUTO_HIDE = 6000;
            //         var navAutoHide = setTimeout(function () {
            //             try { _hideOverlay(); } catch (ex) { }
            //         }, MAX_AUTO_HIDE);

            //         $(window).on('load', function () {
            //             if (navAutoHide) { clearTimeout(navAutoHide); navAutoHide = null; }
            //             // small delay so user sees smooth transition
            //             setTimeout(function () { _hideOverlay(); }, 180);
            //         });
            //     }
            // });

            // expose helpers
            window.showPageLoader = window.showLoading;
            window.hidePageLoader = window.hideLoading;
        })();

        (function () {
            var profileModalEl = document.getElementById('profileModal');
            if (!profileModalEl) return;

            var profileModal = new bootstrap.Modal(profileModalEl);
            var getProfileUrl = '@Url.Action("GetMyProfile", "Profile")';
            var updateProfileUrl = '@Url.Action("UpdateMyProfile", "Profile")';

            function loadProfileData() {
                $.get(getProfileUrl).done(function (res) {
                    if (!res || !res.success || !res.data) return;

                    $('#profileEmployeeCode').val(res.data.EmployeeCode || '');
                    $('#profileEmployeeName').val(res.data.EmployeeName || '');
                    $('#profilePosition').val(res.data.Position || '');
                    $('#profileRoleName').val(res.data.RoleName || '');

                    setProfileAvatar(res.data.AvatarUrl || res.data.AvatarPath || '');
                    $('#profileAvatarFile').val('');
                });
            }

            function setProfileAvatar(url) {
                var $img = $('#profileAvatarPreview');
                var $fallback = $('#profileAvatarFallback');
                if (url) {
                    $img.attr('src', url).removeClass('d-none');
                    $fallback.addClass('d-none');
                } else {
                    $img.attr('src', '').addClass('d-none');
                    $fallback.removeClass('d-none');
                }
            }

            $('#profileAvatarFile').on('change', function () {
                var file = this.files && this.files[0];
                if (!file) return;
                var reader = new FileReader();
                reader.onload = function (e) {
                    setProfileAvatar((e && e.target && e.target.result) ? e.target.result : '');
                };
                reader.readAsDataURL(file);
            });

            $('#btnOpenProfileModal').on('click', function () {
                loadProfileData();
                profileModal.show();
            });

            $('#profileForm').on('submit', function (e) {
                e.preventDefault();
                var token = $('#profileForm').find('input[name="__RequestVerificationToken"]').val()
                    || $('input[name="__RequestVerificationToken"]').first().val();

                var formData = new FormData();
                formData.append('__RequestVerificationToken', token);

                var avatarFile = $('#profileAvatarFile')[0].files[0];
                if (avatarFile) {
                    formData.append('avatarFile', avatarFile);
                }

                $.ajax({
                    url: updateProfileUrl,
                    method: 'POST',
                    data: formData,
                    headers: {
                        'RequestVerificationToken': token
                    },
                    processData: false,
                    contentType: false
                }).done(function (res) {
                    if (res && res.success) {
                        setProfileAvatar(res.avatarUrl || '');

                        var $navImg = $('#navbarAvatarImage');
                        var $navFallback = $('#navbarAvatarFallback');
                        if (res.avatarUrl) {
                            $navImg.attr('src', res.avatarUrl).attr('data-avatar-url', res.avatarUrl).removeClass('d-none');
                            $navFallback.addClass('d-none');
                        } else {
                            $navImg.attr('src', '').attr('data-avatar-url', '').addClass('d-none');
                            $navFallback.removeClass('d-none');
                        }

                        profileModal.hide();
                    }
                    else if (res && res.message) {
                        alert(res.message);
                    }
                });
            });
        })();

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
