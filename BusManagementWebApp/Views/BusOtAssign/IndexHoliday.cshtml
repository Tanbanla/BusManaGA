@model BusManagement.ViewModels.BusOtAssign.BusOtAssignPageViewModel
@{
    ViewData["Title"] = "Sắp xếp xe OT ngày nghỉ";
    var canEdit = Model.CanManage;
}

<style>
    .search-container {
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .quick-search {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
    }

    .quick-search-input {
        width: 100%;
    }

    .route-table {
        background: white;
        border-collapse: collapse;
    }

    .route-table thead th {
        background-color: #f0f6ff;
        color: #1a56db;
        font-weight: 600;
        font-size: 0.82rem;
        white-space: nowrap;
        border-color: #d1e3ff;
        padding: 0.75rem;
        text-align: left;
        border: 1px solid #d1e3ff;
    }

    .route-table tbody td {
        font-size: 0.82rem;
        vertical-align: middle;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
    }

    .route-table tbody tr:hover {
        background-color: #f8faff;
    }

    .bus-cell-merged {
        background-color: #f0f6ff;
        font-weight: 600;
        color: #1a56db;
    }

    .route-type-section {
        margin-bottom: 2rem;
    }

    .section-title {
        background: #f0f6ff;
        color: #1a56db;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.75rem 1rem;
        margin-bottom: 0;
        border-left: 4px solid #1a56db;
        border-radius: 4px 4px 0 0;
    }

    .actions-cell {
        text-align: center;
        white-space: nowrap;
    }

    .actions-cell .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        margin: 0 2px;
    }

    .checkbox-cell {
        text-align: center;
        width: 50px;
    }

    .bus-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .bus-code {
        font-weight: 600;
        color: #185FA5;
    }

    .bus-plate {
        font-size: 0.75rem;
        background: #1e293b;
        color: #f1f5f9;
        display: inline-block;
        padding: 2px 6px;
        border-radius: 3px;
        width: fit-content;
    }

    .driver-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .driver-name {
        font-weight: 500;
    }

    .driver-phone {
        font-size: 0.75rem;
        color: #185FA5;
    }

    .route-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stop-item {
        padding: 2px 0;
        line-height: 1.2;
    }

    .shift-full-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .shift-name {
        font-weight: 600;
        color: #1e293b;
    }

    .shift-time {
        font-size: 0.75rem;
        color: #64748b;
    }

    .shift-note {
        font-size: 0.75rem;
        color: #94a3b8;
        font-style: italic;
    }

    .user-count {
        text-align: center;
        font-weight: 600;
        color: #0F6E56;
    }

    .user-count-disabled {
        text-align: center;
        color: #cbd5e1;
        opacity: 0.6;
    }

    .route-disabled {
        opacity: 0.5;
        color: #cbd5e1;
    }

    mark.qs-highlight {
        background: #fef08a;
        color: #713f12;
        border-radius: 2px;
        padding: 0 2px;
        font-weight: 600;
    }

    /* Backdrop */
    .modal-fullscreen-info {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.7);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .3s ease;
    }

    .modal-fullscreen-info.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    /* Content */
    .modal-fullscreen-info .modal-content-custom {
        width: 95vw;
        height: 95vh;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0,0,0,.3);
        transform: translateY(-50px);
        opacity: 0;
        transition: transform .3s ease-out, opacity .3s ease-out;
    }

    .modal-fullscreen-info.active .modal-content-custom {
        transform: translateY(0);
        opacity: 1;
    }

    /* Header */
    .modal-fullscreen-info .modal-header-custom {
        position: sticky;
        top: 0;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
    }

    /* Body */
    .modal-fullscreen-info .modal-body-custom {
        flex: 1;
        overflow-y: auto;
    }

    /* Footer */
    .modal-fullscreen-info .modal-footer-custom {
        position: sticky;
        bottom: 0;
        background: #fff;
        border-top: 1px solid #e2e8f0;
        padding: 1rem;
        text-align: right;
    }

    .btn-close-modal {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #64748b;
    }

    .btn-close-modal:hover {
        color: #1e293b;
    }

    @@keyframes modalShow {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-fullscreen-info.active .modal-content-custom {
        animation: modalShow .3s ease-out;
    }
</style>
@try
{
    <!-- Info Modal Popup -->
    <div id="infoModalBackdrop" class="modal-fullscreen-info active">
        <div class="modal-content-custom">
            <div class="modal-header-custom">
                <h4 class="m-0">Thông tin sắp xếp xe OT ngày nghỉ</h4>
                <button class="btn-close-modal" id="btnCloseInfoModal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body-custom">
                @await Html.PartialAsync("_info")
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-primary" id="btnConfirmInfo">Đã hiểu</button>
            </div>
        </div>
    </div>

    <div class="bus-ot-assign-card p-3 p-md-4">
        <!-- Header -->
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h5 class="m-0">Sắp xếp xe OT ngày nghỉ</h5>
            <div class="d-flex flex-wrap gap-2">
                @if (canEdit)
                {
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createOtModal">
                        <i class="fa-solid fa-plus me-1"></i>Thêm mới
                    </button>
                }

                <form method="get" asp-controller="BusOtAssign" asp-action="ExportHoliday" class="d-inline js-export-form" data-no-loader>
                    <input type="hidden" name="routeType" value="@Model.RouteType" />
                    <input type="hidden" name="shift" value="@Model.Shift" />
                    <input type="hidden" name="busCode" value="@Model.BusCode" />
                    <input type="hidden" name="driverName" value="@Model.DriverName" />
                    <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                    <input type="hidden" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-file-excel me-1"></i>Xuất Excel
                    </button>
                </form>

                @if (canEdit)
                {
                    <button id="btnBulkDeleteOt" type="button" class="btn btn-danger js-action-button d-none"
                            data-form-id="bulkDeleteOtForm"
                            data-confirm-title="Xóa nhiều xe OT"
                            data-confirm-message="Bạn có chắc chắn muốn xóa các xe OT đã chọn?"
                            data-require-selection="1"
                            disabled>
                        <i class="fa-solid fa-trash-can me-1"></i>Xóa
                    </button>
                }
                <button type="button" class="btn btn-primary" id="btnShowInfoModal">
                    <i class="fas fa-info-circle"></i> Info
                </button>
            </div>
        </div>

        <!-- Search Form -->
        <div class="search-container">
            <form method="get" asp-controller="BusOtAssign" asp-action="IndexHoliday" class="row g-2 js-search-form">
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control" name="busCode" value="@Model.BusCode" placeholder="Ký hiệu xe" />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control" name="driverName" value="@Model.DriverName" placeholder="Tên lái xe" />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control" name="licensePlate" value="@Model.LicensePlate" placeholder="Biển số xe" />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control" type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control" type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-12 col-md-6 col-lg-2 d-grid">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
            <div class="quick-search">
                <input type="text" id="quickSearchStops" class="form-control quick-search-input" placeholder="Tìm kiếm nhanh điểm đón trả..." />
            </div>
        </div>

        @if (canEdit)
        {
            <form id="bulkDeleteOtForm" method="post" asp-controller="BusOtAssign" asp-action="DeleteManyHoliday"
                  class="js-confirm js-require-selection"
                  data-confirm-title="Xóa nhiều xe OT"
                  data-confirm-message="Bạn có chắc chắn muốn xóa các xe OT đã chọn?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="busCode" value="@Model.BusCode" />
                <input type="hidden" name="driverName" value="@Model.DriverName" />
                <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                <input type="hidden" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </form>
        }

        <!-- Table View grouped by Date -->
        <div id="otContainer" class="mt-3">
        @if (!Model.OtAssigns.Any())
        {
            <div class="no-data-message text-center">
                <i class="fa-solid fa-inbox fa-3x mb-3" style="color: #cbd5e1;"></i>
                <p>Không có dữ liệu xe OT ngày nghỉ.</p>
            </div>
        }
        else
        {
            var groupedByDate = Model.OtAssigns
            .GroupBy(x => x.OtDate?.Date)
            .OrderBy(g => g.Key)
            .Select(dateGroup => new
            {
                Date = dateGroup.Key,
                TotalRows = dateGroup.Count(), // tổng số dòng của cả ngày này

                RouteTypes = dateGroup
            .GroupBy(x => x.RouteType)
            .OrderBy(x => x.Key)
            .Select(routeTypeGroup => new
            {
                RouteType = routeTypeGroup.Key,
                TotalRows = routeTypeGroup.Count(), // tổng số dòng của cả RouteType này

                Shifts = routeTypeGroup
            .GroupBy(x => new
            {
                x.Shift,
                x.ShiftInfo,
                x.ShiftNote
            })
            .OrderBy(x => x.Key.Shift)
            .Select(shiftGroup => new
            {
                shiftGroup.Key,
                Items = shiftGroup.ToList()
            })
            })
            })
            .ToList();

            @foreach (var dateGroup in groupedByDate)
            {
                <div class="route-type-section">
                    <div class="section-title">
                        <i class="fa-solid fa-calendar me-2"></i>
                        Ngày: @dateGroup.Date?.ToString("dd/MM/yyyy")
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover route-table">

                            <thead>
                                <tr>
                                    <th>Ngày dùng xe</th>
                                    <th>Xe</th>
                                    <th>Ca làm việc</th>
                                    <th>Lộ trình xe công ty</th>
                                    <th>Dung lượng</th>
                                    <th>Số lượng CNV</th>
                                    <th>Lái xe</th>
                                    <th>SĐT</th>
                                    <th>Biển số xe</th>
                                    @if (canEdit)
                                    {
                                        <th style="width:100px; text-align: center;">Thao tác</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>

                            @{
                                var isFirstRowOfDate = true;
                            }

                            @foreach (var routeTypeGroup in dateGroup.RouteTypes)
                            {
                                var isFirstRowOfRouteType = true;

                                foreach (var shiftGroup in routeTypeGroup.Shifts)
                                {
                                    var rowSpan = shiftGroup.Items.Count;
                                    var isFirstRowOfShift = true;

                                    foreach (var assign in shiftGroup.Items)
                                    {
                                        <tr>

                                            @if (isFirstRowOfDate)
                                            {
                                                <td rowspan="@dateGroup.TotalRows" class="align-middle">
                                                    @(assign.OtDate?.ToString("dd/MM/yyyy"))
                                                </td>
                                                isFirstRowOfDate = false;
                                            }

                                            @if (isFirstRowOfRouteType)
                                            {
                                                <td rowspan="@routeTypeGroup.TotalRows" class="align-middle">
                                                    @(routeTypeGroup.RouteType ?? "")
                                                </td>
                                                isFirstRowOfRouteType = false;
                                            }

                                            @if (isFirstRowOfShift)
                                            {
                                                <td rowspan="@rowSpan" class="align-middle">
                                                    <div class="shift-full-info text-center">
                                                        <span class="shift-name">
                                                            @(shiftGroup.Key.Shift ?? "")
                                                        </span>

                                                        <span class="shift-time">
                                                            @(shiftGroup.Key.ShiftInfo ?? "")
                                                        </span>

                                                        <span class="shift-time">
                                                            @(shiftGroup.Key.ShiftNote ?? "")
                                                        </span>
                                                    </div>
                                                </td>
                                            }

                                            <td>
                                                @if (assign.RouteStops?.Any() == true)
                                                {
                                                    <div class="@(assign.CurrentUser == 0 || assign.CurrentUser == null ? "route-disabled" : "")"
                                                         style="font-size:0.75rem">
                                                        @string.Join(" - ",
                                                            assign.RouteStops
                                                                .OrderBy(s => s.Order)
                                                                .Select(s => $"{s.StopName}")
                                                        )
                                                    </div>
                                                }
                                            </td>

                                            @if (isFirstRowOfShift)
                                            {
                                                <td rowspan="@rowSpan"
                                                    class="text-center align-middle">
                                                    @assign.BusCapacity
                                                </td>

                                                <td rowspan="@rowSpan"
                                                    class="align-middle">
                                                    @shiftGroup.Items.Sum(x => x.CurrentUser ?? 0)
                                                </td>

                                                <td rowspan="@rowSpan"
                                                    class="align-middle">
                                                    @assign.DriverName
                                                </td>

                                                <td rowspan="@rowSpan"
                                                    class="align-middle">
                                                    @assign.DriverPhone
                                                </td>

                                                <td rowspan="@rowSpan"
                                                    class="align-middle">
                                                    @assign.LicensePlate
                                                </td>
                                                @if (canEdit)
                                                {
                                                    <td class="actions-cell" rowspan="@rowSpan">
                                                        <button type="button" class="btn btn-primary btn-sm"
                                                                data-bs-toggle="modal" data-bs-target="#editOtModal-@assign.ID"
                                                                title="Sửa">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>
                                                        <form method="post" asp-controller="BusOtAssign" asp-action="DeleteHoliday" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@assign.ID" />
                                                            <input type="hidden" name="busCode" value="@Model.BusCode" />
                                                            <input type="hidden" name="driverName" value="@Model.DriverName" />
                                                            <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                                                            <input type="hidden" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                                                            <input type="hidden" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                                                            <button type="button" class="btn btn-danger btn-sm js-action-button"
                                                                    data-form-id="deleteOtForm-@assign.ID"
                                                                    data-confirm-title="Xóa xe OT"
                                                                    data-confirm-message="Bạn có chắc chắn muốn xóa xe OT này?"
                                                                    title="Xóa">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                            <input type="hidden" id="deleteOtForm-@assign.ID" />
                                                        </form>
                                                    </td>
                                                }
                                                isFirstRowOfShift = false;
                                            }

                                        </tr>
                                    }
                                }
                            }

                            </tbody>

                        </table>
                    </div>
                </div>
            }
        }
    </div>
    </div>
    
    <!-- Create Modal -->
    <div class="modal fade dragable-modal" id="createOtModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm xe OT ngày nghỉ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="BusOtAssign" asp-action="CreateHoliday" class="js-post-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="SearchRouteType" value="@Model.RouteType" />
                        <input type="hidden" name="SearchBusCode" value="@Model.BusCode" />
                        <input type="hidden" name="SearchDriverName" value="@Model.DriverName" />
                        <input type="hidden" name="SearchLicensePlate" value="@Model.LicensePlate" />
                        <input type="hidden" name="SearchFromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                        <input type="hidden" name="SearchToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Loại tuyến <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="RouteType" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Ngày OT <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" name="OtDate" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Chọn xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="BusId" id="createBusId" required>
                                    <option value="">-- Chọn xe --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Chọn lái xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="DriverId" required>
                                    <option value="">-- Chọn lái xe --</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Chọn lộ trình <span class="text-danger">*</span></label>
                                <select class="form-select" name="RouteId" id="createRouteId" required>
                                    <option value="">-- Chọn lộ trình --</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Tên ca <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Shift" placeholder="VD: Ca sáng, Ca chiều" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Giờ ca (VD: 06:00 - 14:00)</label>
                                <input type="text" class="form-control" name="ShiftTime" placeholder="06:00 - 14:00" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Note ca</label>
                                <input type="text" class="form-control" name="ShiftNote" placeholder="Ghi chú thêm" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal (for each assignment) -->
    @foreach (var assign in Model.OtAssigns)
    {
        <div class="modal fade dragable-modal" id="editOtModal-@assign.ID"
             data-bus-id="@assign.BusId"
             data-driver-id="@assign.DriverId"
             data-route-id="@(assign.RouteId ?? 0)"
             tabindex="-1"
             aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cập nhật xe OT - @assign.BusCode</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-controller="BusOtAssign" asp-action="UpdateHoliday" class="js-post-form">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <input type="hidden" name="ID" value="@assign.ID" />
                            <input type="hidden" name="SearchRouteType" value="@Model.RouteType" />
                            <input type="hidden" name="SearchBusCode" value="@Model.BusCode" />
                            <input type="hidden" name="SearchDriverName" value="@Model.DriverName" />
                            <input type="hidden" name="SearchLicensePlate" value="@Model.LicensePlate" />
                            <input type="hidden" name="SearchFromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                            <input type="hidden" name="SearchToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Loại tuyến <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="RouteType" value="@assign.RouteType" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Ngày OT <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="OtDate" value="@(assign.OtDate?.ToString("yyyy-MM-dd"))" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Chọn xe <span class="text-danger">*</span></label>
                                    <select class="form-select" name="BusId" required>
                                        <option value="@assign.BusId" selected>@assign.BusCode</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Chọn lái xe <span class="text-danger">*</span></label>
                                    <select class="form-select" name="DriverId" required>
                                        <option value="@assign.DriverId" selected>@assign.DriverName</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Chọn lộ trình <span class="text-danger">*</span></label>
                                    <select class="form-select" name="RouteId">
                                        @if (assign.RouteId.HasValue && assign.RouteId > 0)
                                        {
                                            <option value="@assign.RouteId" selected>@assign.RouteName</option>
                                        }
                                        else
                                        {
                                            <option value="">-- Chọn lộ trình --</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Tên ca <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="Shift" value="@assign.Shift" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Giờ ca</label>
                                    <input type="text" class="form-control" name="ShiftTime" value="@assign.ShiftInfo" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Note ca</label>
                                    <input type="text" class="form-control" name="ShiftNote" value="@assign.Type" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Employee List Modal -->
    @foreach (var assign in Model.OtAssigns)
    {
        <div class="modal fade" id="employeeListModal-@assign.ID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Danh sách CNV - @assign.BusCode (@assign.OtDate?.ToString("dd/MM/yyyy"))</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="employeeList-@assign.ID" class="spinner-border" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
catch (Exception ex)
{
    throw ex;
}

@section Scripts {
    @if (TempData["BusOtAssignSuccess"] is string successMessage)
    {
        <script>window.AppCommon && AppCommon.successTopRight(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));</script>
    }
    @if (TempData["BusOtAssignError"] is string errorMessage)
    {
        <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));</script>
    }
    <script>
        (function () {
            // Info modal control
            const infoModalBackdrop = document.getElementById('infoModalBackdrop');
            const btnCloseInfoModal = document.getElementById('btnCloseInfoModal');
            const btnConfirmInfo = document.getElementById('btnConfirmInfo');

            // Mở modal
            document.getElementById("btnShowInfoModal")
                .addEventListener("click", function () {
                    infoModalBackdrop.classList.add("active");
            });

            function closeInfoModal() {
                if (infoModalBackdrop) {
                    infoModalBackdrop.classList.remove('active');
                    localStorage.setItem('infoModalHolidaySeen', 'true');
                }
            }

            function checkInfoModalSeen() {
                const seen = localStorage.getItem('infoModalHolidaySeen');
                if (seen === 'true') {
                    closeInfoModal();
                }
            }

            if (btnCloseInfoModal) btnCloseInfoModal.addEventListener('click', closeInfoModal);
            if (btnConfirmInfo) btnConfirmInfo.addEventListener('click', closeInfoModal);

            checkInfoModalSeen();

            function ensureAntiForgery(form) {
                if (!form) return;
                var tokenInForm = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInForm) return;

                var globalToken = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!globalToken) return;

                var cloned = document.createElement('input');
                cloned.type = 'hidden';
                cloned.name = '__RequestVerificationToken';
                cloned.value = globalToken.value;
                form.appendChild(cloned);
            }

            function showLoading() {
                if (typeof window.showLoading === 'function') {
                    window.showLoading();
                }
            }

            function hideLoading() {
                if (typeof window.hideLoading === 'function') {
                    window.hideLoading();
                }
            }

            document.querySelectorAll('form.js-post-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    ensureAntiForgery(form);
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-search-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-export-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                    setTimeout(function () {
                        hideLoading();
                    }, 2500);
                });
            });

            // Cache data để không fetch lại nhiều lần
            let _buses = null, _drivers = null, _routes = null;

            function fetchBusses() { return _buses || (_buses = fetch('/BusOtAssign/GetBusses').then(r => r.json())); }
            function fetchDrivers() { return _drivers || (_drivers = fetch('/BusOtAssign/GetDrivers').then(r => r.json())); }
            function fetchRoutes() { return _routes || (_routes = fetch('/BusOtAssign/GetRoutes').then(r => r.json())); }

            function fillSelect(select, items, labelFn, selectedId) {
                const placeholder = select.querySelector('option[value=""]')?.textContent || '-- Chọn --';
                select.innerHTML = `<option value="">${placeholder.replace('Đang tải...', 'Chọn')}</option>`;
                items.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = labelFn(item);
                    if (String(item.id) === String(selectedId)) opt.selected = true;
                    select.appendChild(opt);
                });
            }

            // Initialize on modal show
            document.getElementById('createOtModal')?.addEventListener('show.bs.modal', () => {
                const busSelect = document.getElementById('createBusId');
                const driverSelect = document.querySelector('#createOtModal select[name="DriverId"]');
                const routeSelect = document.getElementById('createRouteId');

                fetchBusses().then(data => fillSelect(busSelect, data, b => `${b.code} - ${b.licensePlate} (${b.capacity} chỗ)`, null));
                fetchDrivers().then(data => fillSelect(driverSelect, data, d => `${d.name} - ${d.phone}`, null));
                fetchRoutes().then(data => fillSelect(routeSelect, data, r => `${r.name} (${r.type})`, null));
            });

            // Edit modals
            document.addEventListener('show.bs.modal', function (e) {
                const modal = e.target;
                if (!modal.id.startsWith('editOtModal-')) return;

                const selectedBusId = modal.dataset.busId;
                const selectedDriverId = modal.dataset.driverId;
                const selectedRouteId = modal.dataset.routeId;

                const busSelect = modal.querySelector('select[name="BusId"]');
                const driverSelect = modal.querySelector('select[name="DriverId"]');
                const routeSelect = modal.querySelector('select[name="RouteId"]');

                fetchBusses().then(data => {
                    busSelect.innerHTML = '<option value="">-- Chọn xe --</option>';
                    data.forEach(b => {
                        const opt = document.createElement('option');
                        opt.value = b.id;
                        opt.textContent = `${b.code} - ${b.licensePlate} (${b.capacity} chỗ)`;
                        if (String(b.id) === String(selectedBusId)) opt.selected = true;
                        busSelect.appendChild(opt);
                    });
                });

                fetchDrivers().then(data =>
                    fillSelect(driverSelect, data, d => `${d.name} - ${d.phone}`, selectedDriverId)
                );

                fetchRoutes().then(data =>
                    fillSelect(routeSelect, data, r => `${r.name} (${r.type})`, selectedRouteId)
                );
            });

            // Employee list loading
            document.querySelectorAll('[id^="employeeListModal-"]').forEach(modal => {
                modal.addEventListener('show.bs.modal', async function () {
                    const assignId = this.id.replace('employeeListModal-', '');
                    const listContainer = document.getElementById(`employeeList-${assignId}`);

                    try {
                        const response = await fetch(`/BusOtAssign/GetEmployeesByAssign?assignId=${assignId}`);
                        const employees = await response.json();

                        if (employees && employees.length > 0) {
                            let html = '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>STT</th><th>Mã NV</th><th>Họ tên</th><th>Phòng ban</th></tr></thead><tbody>';
                            employees.forEach((emp, idx) => {
                                html += `<tr><td>${idx + 1}</td><td>${emp.employeeCode || '—'}</td><td>${emp.employeeName || '—'}</td><td>${emp.department || '—'}</td></tr>`;
                            });
                            html += '</tbody></table></div>';
                            listContainer.innerHTML = html;
                        } else {
                            listContainer.innerHTML = '<div class="alert alert-info">Không có CNV nào sử dụng xe này.</div>';
                        }
                    } catch (error) {
                        listContainer.innerHTML = '<div class="alert alert-danger">Lỗi khi tải dữ liệu.</div>';
                    }
                });
            });

            // Bulk delete
            document.addEventListener('click', async function (e) {
                var btn = e.target.closest('.js-action-button');
                if (!btn) return;

                var formId = btn.getAttribute('data-form-id');
                if (!formId) return;
                var form = document.getElementById(formId);
                if (!form) return;

                if (btn.getAttribute('data-require-selection') === '1') {
                    var checked = document.querySelectorAll('.js-ot-check:checked');
                    if (!checked.length) {
                        if (window.AppCommon) AppCommon.warning('Vui lòng chọn ít nhất 1 xe OT.');
                        return;
                    }
                }

                var title = btn.getAttribute('data-confirm-title') || 'Xác nhận';
                var message = btn.getAttribute('data-confirm-message') || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({ title: title, message: message });
                }

                if (!ok) return;
                ensureAntiForgery(form);
                showLoading();

                if (formId.startsWith('deleteOtForm-')) {
                    form.submit();
                } else {
                    form.requestSubmit();
                }
            });

            // Checkbox management
            const bulkDeleteBtn = document.getElementById('btnBulkDeleteOt');
            const rowChecks = Array.prototype.slice.call(document.querySelectorAll('.js-ot-check'));

            function updateBulkDeleteState() {
                if (!bulkDeleteBtn) return;

                var checkedCount = document.querySelectorAll('.js-ot-check:checked').length;
                var hasSelection = checkedCount > 0;

                bulkDeleteBtn.disabled = !hasSelection;
                bulkDeleteBtn.classList.toggle('d-none', !hasSelection);
            }

            rowChecks.forEach(function (c) {
                c.addEventListener('change', updateBulkDeleteState);
            });

            // Select all functionality for each group
            document.querySelectorAll('[id^="selectAll-"]').forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    const section = this.closest('.route-type-section');
                    if (section) {
                        section.querySelectorAll('.js-ot-check').forEach(check => {
                            check.checked = this.checked;
                        });
                    }
                    updateBulkDeleteState();
                });
            });

            updateBulkDeleteState();
        })();
    </script>
}
