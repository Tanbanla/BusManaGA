@section Scripts {
<script>
    (function () {
        if (typeof lottie === 'undefined') return;

        function renderBus(containerId, speed) {
            var el = document.getElementById(containerId);
            if (!el) return;
            var anim = lottie.loadAnimation({
                container: el,
                renderer: 'svg',
                loop: true,
                autoplay: true,
                path: '/lotties/bus_loader.json'
            });
            anim.setSpeed(speed || 0.5);
        }

        renderBus('busLottie1', 0.5);
        renderBus('busLottie2', 0.5);
        renderBus('busLottie3', 0.5);
        renderBus('busLottie4', 0.5);
        renderBus('busLottie5', 1);
    })();

    (function () {
        var hero = document.getElementById('homeHero');
        var btn = document.getElementById('toggleDayNight');
        if (!hero || !btn) return;
        var isManualMode = false;

        function applyMode(mode) {
            var isNight = mode === 'night';
            hero.classList.toggle('is-night', isNight);
            btn.textContent = isNight ? '☀️ Day' : '🌙 Night';
        }

        function getModeByGmt7() {
            var now = new Date();
            var utcMs = now.getTime() + (now.getTimezoneOffset() * 60000);
            var gmt7 = new Date(utcMs + (7 * 60 * 60000));
            var hour = gmt7.getHours();
            return (hour >= 17 || hour < 6) ? 'night' : 'day';
        }

        applyMode(getModeByGmt7());

        setInterval(function () {
            if (isManualMode) return;
            applyMode(getModeByGmt7());
        }, 60000);

        btn.addEventListener('click', function () {
            isManualMode = true;
            var next = hero.classList.contains('is-night') ? 'day' : 'night';
            applyMode(next);
        });
    })();

    (function () {
        var treeLayers = document.querySelectorAll('.home-road .roadside-trees');
        if (!treeLayers.length) return;

        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                treeLayers.forEach(function (el) {
                    el.classList.add('is-ready');
                });
            });
        });
    })();
</script>
}
