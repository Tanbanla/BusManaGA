@section Scripts {
    @if (TempData["BusSuccess"] is string successMessage)
    {
        <script>window.AppCommon && AppCommon.successTopRight(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));</script>
    }
    @if (TempData["BusError"] is string errorMessage)
    {
        <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));</script>
    }

    <script>
        (function () {
            function ensureAntiForgery(form) {
                if (!form) return;
                var tokenInForm = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInForm) return;

                var globalToken = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!globalToken) return;

                var cloned = document.createElement('input');
                cloned.type = 'hidden';
                cloned.name = '__RequestVerificationToken';
                cloned.value = globalToken.value;
                form.appendChild(cloned);
            }

            function showLoading() {
                if (typeof window.showLoading === 'function') {
                    window.showLoading();
                }
            }

            function hideLoading() {
                if (typeof window.hideLoading === 'function') {
                    window.hideLoading();
                }
            }

            document.querySelectorAll('form.js-post-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    ensureAntiForgery(form);
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-search-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-export-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                    setTimeout(function () {
                        hideLoading();
                    }, 2500);
                });
            });

            document.addEventListener('click', async function (e) {
                var btn = e.target.closest('.js-action-button');
                if (!btn) return;

                var formId = btn.getAttribute('data-form-id');
                if (!formId) return;
                var form = document.getElementById(formId);
                if (!form) return;

                if (btn.getAttribute('data-require-selection') === '1') {
                    var checked = document.querySelectorAll('.js-bus-check:checked');
                    if (!checked.length) {
                        if (window.AppCommon) AppCommon.warning('Vui lòng chọn ít nhất 1 xe bus.');
                        return;
                    }
                }

                var title = btn.getAttribute('data-confirm-title') || 'Xác nhận';
                var message = btn.getAttribute('data-confirm-message') || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({ title: title, message: message });
                }

                if (!ok) return;
                ensureAntiForgery(form);
                showLoading();
                form.requestSubmit();
            });

            var chkAll = document.getElementById('chkAllBuses');
            var bulkDeleteBtn = document.getElementById('btnBulkDeleteBuses');
            var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.js-bus-check'));

            function updateBulkDeleteState() {
                if (!bulkDeleteBtn) return;

                var checkedCount = document.querySelectorAll('.js-bus-check:checked').length;
                var hasSelection = checkedCount > 0;

                bulkDeleteBtn.disabled = !hasSelection;
                bulkDeleteBtn.classList.toggle('d-none', !hasSelection);

                if (chkAll) {
                    var total = rowChecks.length;
                    chkAll.checked = total > 0 && checkedCount === total;
                    chkAll.indeterminate = checkedCount > 0 && checkedCount < total;
                }
            }

            if (chkAll) {
                chkAll.addEventListener('change', function () {
                    document.querySelectorAll('.js-bus-check').forEach(function (c) {
                        c.checked = chkAll.checked;
                    });
                    updateBulkDeleteState();
                });
            }

            rowChecks.forEach(function (c) {
                c.addEventListener('change', updateBulkDeleteState);
            });

            async function confirmAction(title, message) {
                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({ title: title, message: message });
                }
                return ok;
            }

            function updateEvaluationBulkState(busId) {
                var checks = document.querySelectorAll('.js-eval-check[data-bus-id="' + busId + '"]');
                var checked = document.querySelectorAll('.js-eval-check[data-bus-id="' + busId + '"]:checked');
                var btn = document.querySelector('.js-bulk-delete-eval-btn[data-bus-id="' + busId + '"]');
                var chkAllEval = document.querySelector('.js-eval-check-all[data-bus-id="' + busId + '"]');

                if (btn) {
                    btn.classList.toggle('d-none', checked.length === 0);
                }
                if (chkAllEval) {
                    chkAllEval.checked = checks.length > 0 && checked.length === checks.length;
                    chkAllEval.indeterminate = checked.length > 0 && checked.length < checks.length;
                }
            }

            document.querySelectorAll('.js-eval-check-all').forEach(function (chk) {
                chk.addEventListener('change', function () {
                    var busId = chk.getAttribute('data-bus-id');
                    document.querySelectorAll('.js-eval-check[data-bus-id="' + busId + '"]').forEach(function (rowChk) {
                        rowChk.checked = chk.checked;
                    });
                    updateEvaluationBulkState(busId);
                });
            });

            document.querySelectorAll('.js-eval-check').forEach(function (chk) {
                chk.addEventListener('change', function () {
                    var busId = chk.getAttribute('data-bus-id');
                    updateEvaluationBulkState(busId);
                });
            });

            document.querySelectorAll('.js-bulk-delete-eval-btn').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var formId = btn.getAttribute('data-form-id');
                    if (!formId) return;
                    var form = document.getElementById(formId);
                    if (!form) return;

                    var selected = form.querySelectorAll('input[name="ids"]:checked');
                    if (!selected.length) return;

                    var ok = await confirmAction('Xóa nhiều đánh giá', 'Bạn có chắc chắn muốn xóa các đánh giá đã chọn?');
                    if (!ok) return;

                    ensureAntiForgery(form);
                    showLoading();
                    form.requestSubmit();
                });
            });

            document.querySelectorAll('.js-delete-eval-one').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var formId = btn.getAttribute('data-form-id');
                    if (!formId) return;
                    var form = document.getElementById(formId);
                    if (!form) return;

                    var ok = await confirmAction('Xóa đánh giá', 'Bạn có chắc chắn muốn xóa đánh giá này?');
                    if (!ok) return;

                    ensureAntiForgery(form);
                    showLoading();
                    form.requestSubmit();
                });
            });

            document.querySelectorAll('.js-bulk-delete-eval-btn').forEach(function (btn) {
                var busId = btn.getAttribute('data-bus-id');
                if (busId) {
                    updateEvaluationBulkState(busId);
                }
            });

            updateBulkDeleteState();
        })();
    </script>
}
