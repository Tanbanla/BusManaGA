@model BusManagement.ViewModels.BusRouteAssign.BusRouteAssignPageViewModel
@{
    ViewData["Title"] = "Quản lý lộ trình xe đi làm cho nhân viên";
    var canEdit = Model.CanManage;
}

<style>
    .search-container {
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .quick-search {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
    }

    .quick-search-input {
        width: 100%;
    }


    .assign-card {
        /* background: #f8fafc; */
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    /* --- Header: thông tin xe --- */
    .assign-bus-header {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
        padding: 1rem 1.25rem 0.875rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .assign-bus-icon {
        width: 44px;
        height: 44px;
        background: #EBF4FE;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #185FA5;
        font-size: 1.1rem;
    }

    .assign-bus-main {
        flex: 1;
        min-width: 0;
    }

    .assign-bus-code {
        font-size: 0.9375rem;
        font-weight: 500;
        color: #1e293b;
    }

        .assign-bus-code span {
            color: #185FA5;
        }

    .assign-bus-meta {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 2px;
    }

    .assign-plate {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #1e293b;
        color: #f1f5f9;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 2px 10px;
        border-radius: 4px;
        letter-spacing: 0.5px;
        margin-top: 5px;
    }

    .assign-checkbox {
        display: flex;
        align-items: center;
    }

    /* --- Driver strip --- */
    .assign-driver-strip {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 1.25rem;
        /* background: #f8fafc; */
        border-bottom: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .assign-driver-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #EAF3DE;
        color: #3B6D11;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        font-weight: 500;
        flex-shrink: 0;
    }

    .assign-driver-name {
        font-size: 0.875rem;
        font-weight: 500;
        color: #1e293b;
    }

    .assign-driver-phone {
        font-size: 0.75rem;
        color: #185FA5;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 1px;
    }

    /* --- Routes grid --- */
    .assign-routes-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .assign-route-col {
        padding: 0.875rem 1.25rem;
    }

        .assign-route-col:first-child {
            border-right: 1px solid #e2e8f0;
        }

    .assign-route-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.6875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 0.75rem;
    }

        .assign-route-label.go {
            color: #0F6E56;
        }

        .assign-route-label.ret {
            color: #A32D2D;
        }

    .assign-route-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .go .assign-route-dot {
        background: #0F6E56;
    }

    .ret .assign-route-dot {
        background: #A32D2D;
    }

    .assign-route-subname {
        font-size: 0.6875rem;
        color: #94a3b8;
        font-style: italic;
        margin-left: auto;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 110px;
    }

    /* --- Timeline stops --- */
    .assign-stop-list {
        position: relative;
    }

    .assign-stop-item {
        display: flex;
        gap: 10px;
        padding-bottom: 14px;
        position: relative;
    }

        .assign-stop-item:last-child {
            padding-bottom: 0;
        }

    .assign-stop-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 20px;
        flex-shrink: 0;
    }

    .assign-stop-num {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.625rem;
        font-weight: 500;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

        .assign-stop-num.go {
            background: #E1F5EE;
            color: #0F6E56;
        }

        .assign-stop-num.ret {
            background: #FCEBEB;
            color: #A32D2D;
        }

    .assign-stop-line {
        width: 1px;
        flex: 1;
        background: #cbd5e1;
        margin-top: 3px;
        min-height: 10px;
    }

    .assign-stop-right {
        flex: 1;
        padding-top: 1px;
    }

    .assign-stop-time {
        font-size: 0.6875rem;
        font-weight: 500;
        color: #185FA5;
        line-height: 1;
        margin-bottom: 1px;
    }

    .assign-stop-name {
        font-size: 0.8125rem;
        color: #1e293b;
        line-height: 1.3;
    }

    .assign-stop-addr {
        font-size: 0.6875rem;
        color: #64748b;
        margin-top: 1px;
        line-height: 1.3;
    }

    .assign-route-empty {
        font-size: 0.75rem;
        color: #94a3b8;
        font-style: italic;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* --- Actions bar --- */
    .assign-actions {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
        padding: 0.625rem 1.25rem;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .route-table thead th {
        background-color: #f0f6ff;
        color: #1a56db;
        font-weight: 600;
        font-size: 0.82rem;
        white-space: nowrap;
        border-color: #d1e3ff;
    }

    .route-table tbody td {
        font-size: 0.82rem;
        vertical-align: middle;
        /* color: #374151; */
    }

    .route-table tbody tr:hover {
        background-color: #f8faff;
    }

    @@media (max-width: 576px) {
        .assign-routes-grid {
            grid-template-columns: 1fr;
        }

        .assign-route-col:first-child {
            border-right: none;
            border-bottom: 1px solid #e2e8f0;
        }
    }

    /* stronger visual for active tab */
    .nav-tabs .nav-link {
        color: #495057;
        background: transparent;
        border: 1px solid transparent;
        border-top-left-radius: .5rem;
        border-top-right-radius: .5rem;
    }

    .nav-tabs .nav-link.active {
        color: #fff;
        background: #0d6efd;
        border-color: #0d6efd #0d6efd transparent;
        box-shadow: 0 6px 18px rgba(13, 110, 253, 0.12);
    }

    mark.qs-highlight {
        background: #fef08a;
        color: #713f12;
        border-radius: 2px;
        padding: 0 2px;
        font-weight: 600;
    }
</style>

@try
{
    <div class="bus-route-assign-card p-3 p-md-4">
        <!-- Header -->
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h5 class="m-0">Lộ trình xe đi làm cho nhân viên</h5>
            <div class="d-flex flex-wrap gap-2">
                @if (canEdit)
                {
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAssignModal">
                        <i class="fa-solid fa-plus me-1"></i>Thêm mới
                    </button>
                }

                <form method="get" asp-controller="BusRouteAssign" asp-action="Export" class="d-inline js-export-form" data-no-loader>
                    <input type="hidden" name="busCode" value="@Model.BusCode" />
                    <input type="hidden" name="driverName" value="@Model.DriverName" />
                    <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                    <input type="hidden" name="isActive" value="@Model.IsActive" />
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-file-excel me-1"></i>Xuất Excel
                    </button>
                </form>

                @if (canEdit)
                {
                    <button id="btnBulkDeleteAssigns" type="button" class="btn btn-danger js-action-button d-none"
                            data-form-id="bulkDeleteAssignForm"
                            data-confirm-title="Xóa nhiều lộ trình"
                            data-confirm-message="Bạn có chắc chắn muốn xóa các lộ trình đã chọn?"
                            data-require-selection="1"
                            disabled>
                        <i class="fa-solid fa-trash-can me-1"></i>Xóa
                    </button>
                }
            </div>
        </div>

        <!-- Search Form -->
        <div class="search-container">
            <form method="get" asp-controller="BusRouteAssign" asp-action="Index" class="row g-2 js-search-form">
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control form-control" name="busCode" value="@Model.BusCode" placeholder="Mã xe" />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control form-control" name="driverName" value="@Model.DriverName" placeholder="Tên lái xe" />
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <input class="form-control form-control" name="licensePlate" value="@Model.LicensePlate" placeholder="Biển số xe" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <!-- Quick Search for stops -->
                    <input type="text" id="quickSearchStops" class="form-control form-control quick-search-input"placeholder="Tìm kiếm nhanh điểm đón, trả..." />
                </div>
                <div class="col-12 col-md-6 col-lg-2 d-grid">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
        </div>

        @if (canEdit)
        {
            <form id="bulkDeleteAssignForm" method="post" asp-controller="BusRouteAssign" asp-action="DeleteMany"
                  class="js-confirm js-require-selection"
                  data-confirm-title="Xóa nhiều lộ trình"
                  data-confirm-message="Bạn có chắc chắn muốn xóa các lộ trình đã chọn?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="busCode" value="@Model.BusCode" />
                <input type="hidden" name="driverName" value="@Model.DriverName" />
                <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                <input type="hidden" name="isActive" value="@Model.IsActive" />
            </form>
        }
        <ul class="nav nav-tabs" id="assignViewTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="table-tab" data-bs-toggle="tab"
                        data-bs-target="#tableView" type="button" role="tab">
                    <i class="fa-solid fa-table me-1"></i>Bảng
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="card-tab" data-bs-toggle="tab"
                        data-bs-target="#cardView" type="button" role="tab">
                    <i class="fa-solid fa-id-card me-1"></i>Thẻ
                </button>
            </li>
        </ul>
        <div class="tab-content" id="assignViewTabContent">
            <!-- Tab bảng -->
            <div class="tab-pane fade show active" id="tableView" role="tabpanel">
                @if (!Model.RouteAssigns.Any())
                {
                    <div class="no-data-message text-center ">
                        <i class="fa-solid fa-inbox fa-3x mb-3" style="color: #cbd5e1;"></i>
                        <p>Không có dữ liệu lộ trình xe.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive mt-2">
                        <table class="table table-bordered table-hover align-middle route-table">
                            <thead>
                                <tr>
                                    <th style="width:70px;">Xe</th>
                                    <th>Lộ trình chiều đi</th>
                                    <th>Lộ trình chiều về</th>
                                    <th style="width:75px;" class="text-center">Loại xe</th>
                                    <th style="width:110px;">Lái xe</th>
                                    <th style="width:120px;">Điện thoại</th>
                                    <th style="width:110px;">Biển số xe</th>
                                    @if (canEdit)
                                    {
                                        <th style="width:80px;" class="text-center">Thao tác</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assign in Model.RouteAssigns)
                                {
                                    var pickupRoute = assign.PickupStops.Any()
                                        ? string.Join(" - ", assign.PickupStops.Select(s =>
                                            $"({s.PickupTime?.ToString(@"hh\:mm")}) {s.StopName}"))
                                        : assign.PickupRouteName ?? "—";

                                    var returnRoute = assign.ReturnStops.Any()
                                        ? string.Join(" - ", assign.ReturnStops.Select(s =>
                                            $"({s.PickupTime?.ToString(@"hh\:mm")}) {s.StopName}"))
                                        : assign.ReturnRouteName ?? "—";
                                    <tr data-assign-id="@assign.ID">
                                        <td class="fw-semibold text-primary">@assign.BusCode</td>
                                        <td>@pickupRoute</td>
                                        <td>@returnRoute</td>
                                        <td class="text-center">@assign.BusCapacity</td>
                                        <td>@assign.DriverName</td>
                                        <td>@assign.DriverPhone</td>
                                        <td>@assign.LicensePlate</td>
                                        @if (canEdit)
                                        {
                                            <td class="text-center">
                                                <button type="button" class="btn btn-primary btn-sm mb-1"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editAssignModal-@assign.ID"
                                                        title="Sửa">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                <form method="post" asp-controller="BusRouteAssign"
                                                      asp-action="Delete" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@assign.ID" />
                                                    <input type="hidden" name="busCode" value="@Model.BusCode" />
                                                    <input type="hidden" name="driverName" value="@Model.DriverName" />
                                                    <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm js-action-button"
                                                            data-form-id="deleteAssignFormTbl-@assign.ID"
                                                            data-confirm-title="Xóa lộ trình"
                                                            data-confirm-message="Bạn có chắc chắn muốn xóa lộ trình này?"
                                                            title="Xóa">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                    <input type="hidden" id="deleteAssignFormTbl-@assign.ID" />
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="cardView" role="tabpanel">
                <!-- Assignments List -->
                <div id="assignmentsContainer" class="mt-2">
                    @if (!Model.RouteAssigns.Any())
                    {
                        <div class="no-data-message">
                            <i class="fa-solid fa-inbox fa-3x mb-3" style="color: #cbd5e1;"></i>
                            <p>Không có dữ liệu lộ trình xe.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var assign in Model.RouteAssigns)
                        {
                            <div class="assign-card" data-assign-id="@assign.ID">

                                <div class="assign-bus-header">
                                    <div class="assign-bus-icon">
                                        <i class="fa-solid fa-bus"></i>
                                    </div>
                                    <div class="assign-bus-main">
                                        <div class="assign-bus-code">
                                            <span>@assign.BusCode</span> &nbsp;·&nbsp; @assign.BusName
                                            <div class="assign-plate ms-2">
                                                <i class="fa-solid fa-id-card" style="font-size:0.65rem;"></i>
                                                @assign.LicensePlate
                                            </div>
                                        </div>
                                        <div class="assign-bus-meta">@assign.BusCapacity chỗ</div>
                                    </div>
                                    <div class="assign-driver-strip">
                                        @{
                                            var initials = string.Join("", (assign.DriverName ?? "?")
                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                            .TakeLast(2).Select(w => w[0]));
                                        }
                                        <div class="assign-driver-avatar">@initials</div>
                                        <div>
                                            <div class="assign-driver-name">@assign.DriverName</div>
                                            <div class="assign-driver-phone">
                                                <i class="fa-solid fa-phone" style="font-size:0.65rem;"></i>
                                                @assign.DriverPhone
                                            </div>
                                        </div>
                                    </div>
                                    @if (canEdit)
                                    {
                                        @* <div class="assign-actions"> *@
                                        <div class="">
                                            <button type="button" class="btn btn-primary btn-sm"
                                                    data-bs-toggle="modal" data-bs-target="#editAssignModal-@assign.ID">
                                                <i class="fa-solid fa-pen me-1"></i>Sửa
                                            </button>
                                            <form method="post" asp-controller="BusRouteAssign" asp-action="Delete" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@assign.ID" />
                                                <input type="hidden" name="busCode" value="@Model.BusCode" />
                                                <input type="hidden" name="driverName" value="@Model.DriverName" />
                                                <input type="hidden" name="licensePlate" value="@Model.LicensePlate" />
                                                <button type="button" class="btn btn-danger btn-sm js-action-button"
                                                        data-form-id="deleteAssignForm-@assign.ID"
                                                        data-confirm-title="Xóa lộ trình"
                                                        data-confirm-message="Bạn có chắc chắn muốn xóa lộ trình này?">
                                                    <i class="fa-solid fa-trash me-1"></i>Xóa
                                                </button>
                                                <input type="hidden" id="deleteAssignForm-@assign.ID" />
                                            </form>
                                        </div>
                                    }

                                    @if (canEdit)
                                    {
                                        <div class="assign-checkbox">
                                            <input type="checkbox" class="form-check-input js-assign-check"
                                                   name="ids" value="@assign.ID" form="bulkDeleteAssignForm" />
                                        </div>
                                    }
                                </div>

                                <div class="assign-routes-grid">

                                    <div class="assign-route-col">
                                        <div class="assign-route-label go">
                                            <span class="assign-route-dot"></span>
                                            Chiều đi
                                            @if (!string.IsNullOrWhiteSpace(assign.PickupRouteName))
                                            {
                                                <span class="assign-route-subname">@assign.PickupRouteName</span>
                                            }
                                        </div>
                                        @if (assign.PickupStops.Any())
                                        {
                                            <div class="assign-stop-list">
                                                @foreach (var (stop, idx) in assign.PickupStops.Select((s, i) => (s, i)))
                                                {
                                                    <div class="assign-stop-item"
                                                         data-stop-name="@stop.StopName"
                                                         data-stop-time="@stop.PickupTime?.ToString(@"hh\:mm")">
                                                        <div class="assign-stop-left">
                                                            <div class="assign-stop-num go">@(idx + 1)</div>
                                                            @if (idx < assign.PickupStops.Count - 1)
                                                            {
                                                                <div class="assign-stop-line"></div>
                                                            }
                                                        </div>
                                                        <div class="assign-stop-right">
                                                            <div class="assign-stop-time">@stop.PickupTime?.ToString(@"hh\:mm")</div>
                                                            <div class="assign-stop-name">@stop.StopName</div>
                                                            <div class="assign-stop-addr">@stop.StopAddress</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="assign-route-empty">
                                                <i class="fa-solid fa-circle-info" style="font-size:0.75rem;"></i>
                                                Không có điểm dừng
                                            </div>
                                        }
                                    </div>

                                    <div class="assign-route-col">
                                        <div class="assign-route-label ret">
                                            <span class="assign-route-dot"></span>
                                            Chiều về
                                            @if (!string.IsNullOrWhiteSpace(assign.ReturnRouteName))
                                            {
                                                <span class="assign-route-subname">@assign.ReturnRouteName</span>
                                            }
                                        </div>
                                        @if (assign.ReturnStops.Any())
                                        {
                                            <div class="assign-stop-list">
                                                @foreach (var (stop, idx) in assign.ReturnStops.Select((s, i) => (s, i)))
                                                {
                                                    <div class="assign-stop-item"
                                                         data-stop-name="@stop.StopName"
                                                         data-stop-time="@stop.PickupTime?.ToString(@"hh\:mm")">
                                                        <div class="assign-stop-left">
                                                            <div class="assign-stop-num ret">@(idx + 1)</div>
                                                            @if (idx < assign.ReturnStops.Count - 1)
                                                            {
                                                                <div class="assign-stop-line"></div>
                                                            }
                                                        </div>
                                                        <div class="assign-stop-right">
                                                            <div class="assign-stop-time">@stop.PickupTime?.ToString(@"hh\:mm")</div>
                                                            <div class="assign-stop-name">@stop.StopName</div>
                                                            <div class="assign-stop-addr">@stop.StopAddress</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="assign-route-empty">
                                                <i class="fa-solid fa-circle-info" style="font-size:0.75rem;"></i>
                                                Không có điểm dừng
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Create Modal -->
    <div class="modal fade dragable-modal" id="createAssignModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm lộ trình xe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="BusRouteAssign" asp-action="Create" class="js-post-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="SearchBusCode" value="@Model.BusCode" />
                        <input type="hidden" name="SearchDriverName" value="@Model.DriverName" />
                        <input type="hidden" name="SearchLicensePlate" value="@Model.LicensePlate" />
                        <input type="hidden" name="SearchIsActive" value="@Model.IsActive" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Chọn xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="BusId" id="createBusId" required>
                                    <option value="">-- Chọn xe --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Chọn lái xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="DriverId" required>
                                    <option value="">-- Chọn lái xe --</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Lộ trình chiều đi</label>
                                <select class="form-select" name="RoutePickupId" id="createRoutePickupId">
                                    <option value="">-- Chọn lộ trình --</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Lộ trình chiều về</label>
                                <select class="form-select" name="RouteReturnId" id="createRouteReturnId">
                                    <option value="">-- Chọn lộ trình --</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Ngày hiệu lực</label>
                                <input type="date" class="form-control" name="EffectiveDate" />
                            </div>
                            <div class="col-12">
                                <div class="alert alert-info" role="alert">
                                    <small><strong>Lưu ý:</strong> Bạn phải chọn ít nhất một lộ trình (chiều đi hoặc chiều về)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal (for each assignment) -->
    @foreach (var assign in Model.RouteAssigns)
    {
        <div class="modal fade dragable-modal" id="editAssignModal-@assign.ID"
             data-bus-code="@assign.BusCode"
             data-driver-id="@assign.DriverId"
             data-pickup-route-id="@(assign.PickupRouteId ?? 0)"
             data-return-route-id="@(assign.ReturnRouteId ?? 0)"
             tabindex="-1" 
             aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cập nhật lộ trình xe - @assign.BusCode</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-controller="BusRouteAssign" asp-action="Update" class="js-post-form">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <input type="hidden" name="ID" value="@assign.ID" />
                            <input type="hidden" name="SearchBusCode" value="@Model.BusCode" />
                            <input type="hidden" name="SearchDriverName" value="@Model.DriverName" />
                            <input type="hidden" name="SearchLicensePlate" value="@Model.LicensePlate" />
                            <input type="hidden" name="SearchIsActive" value="@Model.IsActive" />

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Chọn xe <span class="text-danger">*</span></label>
                                    <select class="form-select" name="BusId" required>
                                        <option value="@assign.BusCode" selected>@assign.BusCode</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Chọn lái xe <span class="text-danger">*</span></label>
                                    <select class="form-select" name="DriverId" required>
                                        <option value="@assign.DriverId" selected>@assign.DriverName</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Lộ trình chiều đi</label>
                                    <select class="form-select" name="RoutePickupId">
                                        @if (assign.PickupRouteId.HasValue && assign.PickupRouteId > 0)
                                        {
                                            <option value="@assign.PickupRouteId" selected>@assign.PickupRouteName</option>
                                        }
                                        else
                                        {
                                            <option value="">-- Chọn lộ trình --</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Lộ trình chiều về</label>
                                    <select class="form-select" name="RouteReturnId">
                                        @if (assign.ReturnRouteId.HasValue && assign.ReturnRouteId > 0)
                                        {
                                            <option value="@assign.ReturnRouteId" selected>@assign.ReturnRouteName</option>
                                        }
                                        else
                                        {
                                            <option value="">-- Chọn lộ trình --</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ngày hiệu lực</label>
                                    <input type="date" class="form-control" name="EffectiveDate" value="@(assign.EffectiveDate.HasValue ? assign.EffectiveDate.Value.ToString("yyyy-MM-dd") : "")" />
                                </div>
                                <div class="col-12">
                                    <div class="alert alert-info" role="alert">
                                        <small><strong>Lưu ý:</strong> Bạn phải chọn ít nhất một lộ trình (chiều đi hoặc chiều về)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
catch (Exception ex)
{
    throw ex;
}

@section Scripts {
    @if (TempData["BusRouteAssignSuccess"] is string successMessage)
    {
        <script>window.AppCommon && AppCommon.successTopRight(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));</script>
    }
    @if (TempData["BusRouteAssignError"] is string errorMessage)
    {
        <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));</script>
    }

    <script>
        (function () {
            const container = document.getElementById('assignmentsContainer');

            function ensureAntiForgery(form) {
                if (!form) return;
                var tokenInForm = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInForm) return;

                var globalToken = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!globalToken) return;

                var cloned = document.createElement('input');
                cloned.type = 'hidden';
                cloned.name = '__RequestVerificationToken';
                cloned.value = globalToken.value;
                form.appendChild(cloned);
            }

            function showLoading() {
                if (typeof window.showLoading === 'function') {
                    window.showLoading();
                }
            }

            function hideLoading() {
                if (typeof window.hideLoading === 'function') {
                    window.hideLoading();
                }
            }

            document.querySelectorAll('form.js-post-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    ensureAntiForgery(form);
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-search-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-export-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                    setTimeout(function () {
                        hideLoading();
                    }, 2500);
                });
            });

            // Cache data để không fetch lại nhiều lần
            let _buses = null, _drivers = null, _routes = null;
            const staffRouteTypeId = 1;

            function fetchBusses()  { return _buses   || (_buses   = fetch('/BusRouteAssign/GetBusses').then(r => r.json())); }
            function fetchDrivers() { return _drivers || (_drivers = fetch('/BusRouteAssign/GetDrivers').then(r => r.json())); }
            function fetchRoutes()  { return _routes  || (_routes  = fetch('/BusRouteAssign/GetRoutes?routeTypeId=' + staffRouteTypeId).then(r => r.json())); }

            function fillSelect(select, items, labelFn, selectedId) {
                const placeholder = select.querySelector('option[value=""]')?.textContent || '-- Chọn --';
                select.innerHTML = `<option value="">${placeholder.replace('Đang tải...', 'Chọn')}</option>`;
                items.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = labelFn(item);
                    if (String(item.id) === String(selectedId)) opt.selected = true;
                    select.appendChild(opt);
                });
            }

            // Initialize on modal show
            // Create modal
            document.getElementById('createAssignModal')?.addEventListener('show.bs.modal', () => {
                const busSelect    = document.getElementById('createBusId');
                const driverSelect = document.querySelector('#createAssignModal select[name="DriverId"]');
                const pickupSelect = document.getElementById('createRoutePickupId');
                const returnSelect = document.getElementById('createRouteReturnId');

                fetchBusses().then(data  => fillSelect(busSelect,    data, b => `${b.code} - ${b.licensePlate} (${b.capacity} chỗ)`, null));
                fetchDrivers().then(data => fillSelect(driverSelect, data, d => `${d.name} - ${d.phone}`, null));
                fetchRoutes().then(data  => {
                    fillSelect(pickupSelect, data, r => `${r.name} (${r.type})`, null);
                    fillSelect(returnSelect, data, r => `${r.name} (${r.type})`, null);
                });
            });

            // Edit modals — dùng event delegation vì show.bs.modal không bubble
            document.addEventListener('show.bs.modal', function (e) {
                const modal = e.target;
                if (!modal.id.startsWith('editAssignModal-')) return;

                const selectedBusCode  = modal.dataset.busCode;
                const selectedDriverId = modal.dataset.driverId;
                const selectedPickupId = modal.dataset.pickupRouteId;
                const selectedReturnId = modal.dataset.returnRouteId;

                const busSelect    = modal.querySelector('select[name="BusId"]');
                const driverSelect = modal.querySelector('select[name="DriverId"]');
                const pickupSelect = modal.querySelector('select[name="RoutePickupId"]');
                const returnSelect = modal.querySelector('select[name="RouteReturnId"]');

                // Xe: value = b.id, nhưng match selected bằng b.code
                fetchBusses().then(data => {
                    busSelect.innerHTML = '<option value="">-- Chọn xe --</option>';
                    data.forEach(b => {
                        const opt = document.createElement('option');
                        opt.value = b.id;
                        opt.textContent = `${b.code} - ${b.licensePlate} (${b.capacity} chỗ)`;
                        if (b.code === selectedBusCode) opt.selected = true;
                        busSelect.appendChild(opt);
                    });
                });

                // Lái xe: match bằng id bình thường
                fetchDrivers().then(data =>
                    fillSelect(driverSelect, data, d => `${d.name} - ${d.phone}`, selectedDriverId)
                );

                // Lộ trình: match bằng id bình thường
                fetchRoutes().then(data => {
                    fillSelect(pickupSelect, data, r => `${r.name} (${r.type})`, selectedPickupId);
                    fillSelect(returnSelect, data, r => `${r.name} (${r.type})`, selectedReturnId);
                });
            });

            // Quick search functionality - fix class names + support cả 2 tab
            const quickSearchInput = document.getElementById('quickSearchStops');

            if (quickSearchInput) {
                // Hàm highlight text
                function highlightText(text, query) {
                    if (!query) return text;
                    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const regex = new RegExp(`(${escaped})`, 'gi');
                    return text.replace(regex, '<mark class="qs-highlight">$1</mark>');
                }

                // Lưu text gốc để restore
                function saveOriginal(el, attr) {
                    if (!el.hasAttribute(attr)) {
                        el.setAttribute(attr, el.innerHTML);
                    }
                }

                function restoreOriginal(el, attr) {
                    if (el.hasAttribute(attr)) {
                        el.innerHTML = el.getAttribute(attr);
                    }
                }

                quickSearchInput.addEventListener('input', function () {
                    const query = this.value.trim().toLowerCase();

                    // --- Card View ---
                    const cards = document.querySelectorAll('#cardView .assign-card');
                    cards.forEach(card => {
                        const stops = card.querySelectorAll('.assign-stop-item');
                        let cardMatched = false;

                        stops.forEach(stop => {
                            const nameEl = stop.querySelector('.assign-stop-name');
                            const timeEl = stop.querySelector('.assign-stop-time');

                            // Restore trước
                            if (nameEl) restoreOriginal(nameEl, 'data-orig-html');
                            if (timeEl) restoreOriginal(timeEl, 'data-orig-html');

                            if (!query) return;

                            const name = (stop.getAttribute('data-stop-name') || '').toLowerCase();
                            const time = (stop.getAttribute('data-stop-time') || '').toLowerCase();
                            const stopMatched = name.includes(query) || time.includes(query);

                            if (stopMatched) {
                                cardMatched = true;
                                if (nameEl) {
                                    saveOriginal(nameEl, 'data-orig-html');
                                    nameEl.innerHTML = highlightText(nameEl.innerHTML, query);
                                }
                                if (timeEl) {
                                    saveOriginal(timeEl, 'data-orig-html');
                                    timeEl.innerHTML = highlightText(timeEl.innerHTML, query);
                                }
                            }
                        });

                        card.style.display = !query || cardMatched ? '' : 'none';
                    });

                    // --- Table View ---
                    const rows = document.querySelectorAll('#tableView tbody tr');
                    rows.forEach(row => {
                        const pickupCell = row.cells[1];
                        const returnCell = row.cells[2];

                        // Restore trước
                        if (pickupCell) restoreOriginal(pickupCell, 'data-orig-html');
                        if (returnCell) restoreOriginal(returnCell, 'data-orig-html');

                        if (!query) {
                            row.style.display = '';
                            return;
                        }

                        const pickupText = (pickupCell?.textContent || '').toLowerCase();
                        const returnText = (returnCell?.textContent || '').toLowerCase();
                        const matched = pickupText.includes(query) || returnText.includes(query);

                        row.style.display = matched ? '' : 'none';

                        if (matched) {
                            if (pickupCell) {
                                saveOriginal(pickupCell, 'data-orig-html');
                                pickupCell.innerHTML = highlightText(pickupCell.innerHTML, query);
                            }
                            if (returnCell) {
                                saveOriginal(returnCell, 'data-orig-html');
                                returnCell.innerHTML = highlightText(returnCell.innerHTML, query);
                            }
                        }
                    });
                });
            }

            // Bulk delete
            document.addEventListener('click', async function (e) {
                var btn = e.target.closest('.js-action-button');
                if (!btn) return;

                var formId = btn.getAttribute('data-form-id');
                if (!formId) return;
                var form = document.getElementById(formId);
                if (!form) return;

                if (btn.getAttribute('data-require-selection') === '1') {
                    var checked = document.querySelectorAll('.js-assign-check:checked');
                    if (!checked.length) {
                        if (window.AppCommon) AppCommon.warning('Vui lòng chọn ít nhất 1 lộ trình.');
                        return;
                    }
                }

                var title = btn.getAttribute('data-confirm-title') || 'Xác nhận';
                var message = btn.getAttribute('data-confirm-message') || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
                var ok = true;
                if (window.AppCommon && typeof AppCommon.confirm === 'function') {
                    ok = await AppCommon.confirm({ title: title, message: message });
                }

                if (!ok) return;
                ensureAntiForgery(form);
                showLoading();

                if (formId.startsWith('deleteAssignForm-')) {
                    form.submit();
                } else {
                    form.requestSubmit();
                }
            });

            // Checkbox management
            const bulkDeleteBtn = document.getElementById('btnBulkDeleteAssigns');
            const rowChecks = Array.prototype.slice.call(document.querySelectorAll('.js-assign-check'));

            function updateBulkDeleteState() {
                if (!bulkDeleteBtn) return;

                var checkedCount = document.querySelectorAll('.js-assign-check:checked').length;
                var hasSelection = checkedCount > 0;

                bulkDeleteBtn.disabled = !hasSelection;
                bulkDeleteBtn.classList.toggle('d-none', !hasSelection);
            }

            rowChecks.forEach(function (c) {
                c.addEventListener('change', updateBulkDeleteState);
            });

            updateBulkDeleteState();
        })();
    </script>
}
