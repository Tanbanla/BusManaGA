@{
    ViewData["Title"] = "Phân quyền theo vai trò";
}

<style>
    .admin-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }
</style>

<div class="admin-card p-3 p-md-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <h5 class="m-0">Phân quyền - Role: <span class="text-primary">Admin</span></h5>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" asp-controller="Admin" asp-action="Roles">Back</a>
            <button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save permissions</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle table-bordered">
            <thead class="table-light text-center">
                <tr>
                    <th class="text-start">Module</th>
                    <th>View</th>
                    <th>Create</th>
                    <th>Update</th>
                    <th>Delete</th>
                    <th>Approve</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Quản lý người dùng</td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                </tr>
                <tr>
                    <td>Danh sách CNV sử dụng xe</td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" /></td>
                </tr>
                <tr>
                    <td>Báo cáo</td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" /></td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" checked /></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
