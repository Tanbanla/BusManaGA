            async function loadRouteCapacityDetail(assignId) {
                var body = document.getElementById('employeeRouteCapacityDetailBody');
                if (!body) return;
                body.innerHTML = '<div class="text-center text-muted py-4">Đang tải chi tiết...</div>';

                try {
                    var response = await fetch('@Url.Action("GetRouteCapacityDetail", "EmployeeBus")?assignId=' + encodeURIComponent(assignId));
                    if (!response.ok) throw new Error('load detail fail');
                    var result = await response.json();
                    if (!result || !result.success || !result.data) throw new Error('invalid');

                    var data = result.data;
                    function renderStops(stops) {
                        if (!Array.isArray(stops) || !stops.length) {
                            return '<div class="text-muted fst-italic">Không có điểm dừng</div>';
                        }
                        return '<ul class="list-group list-group-flush">' + stops.map(function (s) {
                            return '<li class="list-group-item px-0">'
                                + '<div class="small text-primary fw-semibold">' + (s.pickupTime || '') + '</div>'
                                + '<div>' + (s.stopName || '') + '</div>'
                                + '<div class="small text-muted">' + (s.stopAddress || '') + '</div>'
                                + '</li>';
                        }).join('') + '</ul>';
                    }

                    body.innerHTML = '<div class="mb-3">'
                        + '<div class="fw-semibold text-primary">' + (data.busCode || '') + ' - ' + (data.busName || '') + '</div>'
                        + '<div class="small text-muted">Biển số: ' + (data.licensePlate || '') + '</div>'
                        + '<div class="small">Dung lượng: <strong>' + (data.currentUser || 0) + '/' + (data.busCapacity || 0) + '</strong></div>'
                        + '</div>'
                        + '<div class="row g-3">'
                        + '<div class="col-12 col-md-6"><div class="border rounded p-3"><div class="fw-semibold mb-2">Chiều đi - ' + (data.pickupRouteName || '') + '</div>' + renderStops(data.pickupStops) + '</div></div>'
                        + '<div class="col-12 col-md-6"><div class="border rounded p-3"><div class="fw-semibold mb-2">Chiều về - ' + (data.returnRouteName || '') + '</div>' + renderStops(data.returnStops) + '</div></div>'
                        + '</div>';
                } catch {
                    body.innerHTML = '<div class="alert alert-danger mb-0">Không thể tải chi tiết tuyến.</div>';
                }
            }

