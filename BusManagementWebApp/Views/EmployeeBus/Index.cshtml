@model BusManagement.ViewModels.EmployeeBus.EmployeeBusPageViewModel
@{
    ViewData["Title"] = "Danh sách CNV sử dụng xe công ty";
    var startIndex = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize + 1);
    var endIndex = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

<style>
    .employeebus-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

    .table thead th {
        white-space: nowrap;
        vertical-align: middle;
    }

    /* Select2 styling to mimic selectpicker/bootstrap look */
    .select2-container--default .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        padding: .375rem .75rem;
        border: 1px solid #ced4da;
        border-radius: .375rem;
        background-color: #fff;
        box-shadow: none;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 1.5;
        color: #212529;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem + 2px);
        right: .5rem;
    }
    .select2-container .select2-search--dropdown .select2-search__field {
        width: 100% !important;
        padding: .375rem .75rem;
        border-radius: .25rem;
    }

</style>

<div class="employeebus-card p-3 p-md-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <h5 class="m-0">Danh sách CNV sử dụng xe công ty</h5>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.CanManage)
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEmployeeBusModal">
                    <i class="fa-solid fa-plus me-1"></i>Thêm mới
                </button>
            }

            <form method="get" asp-controller="EmployeeBus" asp-action="Export" class="d-inline js-export-form" data-no-loader>
                <input type="hidden" name="employeeCode" value="@Model.EmployeeCode" />
                <input type="hidden" name="employeeName" value="@Model.EmployeeName" />
                <input type="hidden" name="department" value="@Model.Department" />
                <input type="hidden" name="phone" value="@Model.Phone" />
                <input type="hidden" name="city" value="@Model.City" />
                <input type="hidden" name="ward" value="@Model.Ward" />
                <input type="hidden" name="busStopId" value="@Model.BusStopId" />
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-file-excel me-1"></i>Xuất Excel
                </button>
            </form>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#employeeRouteCapacityModal">
                <i class="fa-solid fa-bus me-1"></i>Xem dung lượng tuyến
            </button>

            @if (Model.CanManage)
            {
                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#importEmployeeBusModal">
                    <i class="fa-solid fa-file-import me-1"></i>Import Excel
                </button>

                <button id="btnBulkDeleteEmployees" type="button" class="btn btn-danger js-action-button d-none"
                        data-form-id="bulkDeleteEmployeeBusForm"
                        data-confirm-title="Xóa nhiều CNV"
                        data-confirm-message="Bạn có chắc chắn muốn xóa các CNV đã chọn?"
                        data-require-selection="1"
                        disabled>
                    <i class="fa-solid fa-trash-can me-1"></i>Xóa đã chọn
                </button>
            }
        </div>
    </div>

    <form method="get" asp-controller="EmployeeBus" asp-action="Index" class="row g-2 mb-3 js-search-form">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        <div class="col-12 col-md-6 col-lg-2">
            <input class="form-control" name="employeeCode" value="@Model.EmployeeCode" placeholder="Mã NV" />
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <input class="form-control" name="employeeName" value="@Model.EmployeeName" placeholder="Họ và tên" />
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <select class="w-100 selectpicker" data-live-search="true" data-size="8" name="department" title="Tất cả phòng ban">
                <option value="">Tất cả phòng ban</option>
                @foreach (var section in Model.Sections)
                {
                    var secCode = section.CHR_CODE?.Trim();
                    var secName = section.CHR_NAME ?? section.CHR_SECTION_NAME ?? secCode;
                    if (string.IsNullOrWhiteSpace(secCode))
                    {
                        continue;
                    }

                    if (string.Equals(Model.Department, secCode, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@secCode" selected>@secName</option>
                    }
                    else
                    {
                        <option value="@secCode">@secName</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <input class="form-control" name="phone" value="@Model.Phone" placeholder="SĐT" />
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <select id="searchCitySelect" class="form-select js-city-select" name="city" data-allow-empty="true">
                <option value="">Tất cả tỉnh/thành</option>
                @foreach (var cityOption in Model.Cities)
                {
                    if (!string.IsNullOrWhiteSpace(cityOption.NVCHR_CITY_NAME))
                    {
                        var cityName = cityOption.NVCHR_CITY_NAME.Trim();
                        if (string.Equals(Model.City, cityName, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@cityName" data-city-id="@cityOption.ID" selected>@cityName</option>
                        }
                        else
                        {
                            <option value="@cityName" data-city-id="@cityOption.ID">@cityName</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <select id="searchWardSelect" class="form-select js-ward-select" name="ward" data-allow-empty="true">
                <option value="">Tất cả xã/phường</option>
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <select class="w-100 selectpicker" data-live-search="true" data-size="8" name="busStopId" title="Tất cả điểm đón trả">
                <option value="">Tất cả điểm đón trả</option>
                @foreach (var cityGroup in Model.BusStops.GroupBy(x => string.IsNullOrWhiteSpace(x.NVCHR_STOP_CITY) ? "Khác" : x.NVCHR_STOP_CITY).OrderBy(x => x.Key))
                {
                    <optgroup label="@cityGroup.Key">
                        @foreach (var busStop in cityGroup.OrderBy(x => x.NVCHR_STOP_WARD).ThenBy(x => x.NVCHR_STOP_NAME))
                        {
                            if (Model.BusStopId == busStop.ID)
                            {
                                <option value="@busStop.ID" selected>@Model.GetBusStopDisplayName(busStop.ID)</option>
                            }
                            else
                            {
                                <option value="@busStop.ID">@Model.GetBusStopDisplayName(busStop.ID)</option>
                            }
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
    </form>

    @if (Model.CanManage)
    {
        <form id="bulkDeleteEmployeeBusForm" method="post" asp-controller="EmployeeBus" asp-action="DeleteMany" class="js-confirm js-require-selection"
              data-confirm-title="Xóa nhiều CNV"
              data-confirm-message="Bạn có chắc chắn muốn xóa các CNV đã chọn?">
            @Html.AntiForgeryToken()
            <input type="hidden" name="employeeCode" value="@Model.EmployeeCode" />
            <input type="hidden" name="employeeName" value="@Model.EmployeeName" />
            <input type="hidden" name="department" value="@Model.Department" />
            <input type="hidden" name="phone" value="@Model.Phone" />
            <input type="hidden" name="city" value="@Model.City" />
            <input type="hidden" name="ward" value="@Model.Ward" />
            <input type="hidden" name="busStopId" value="@Model.BusStopId" />
            <input type="hidden" name="page" value="@Model.PageNumber" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </form>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    @if (Model.CanManage)
                    {
                        <th style="width:40px;"><input id="chkAllEmployeeBus" type="checkbox" class="form-check-input" /></th>
                    }
                    <th>STT</th>
                    <th>Mã NV</th>
                    <th>Họ và tên</th>
                    <th>Phòng ban</th>
                    <th>SĐT</th>
                    <th>Tỉnh</th>
                    <th>Xã</th>
                    <th>Địa chỉ chi tiết</th>
                    <th>Chiều đến(mã xe)</th>
                    <th>Chiều về(mã xe)</th>
                    <th>Điểm đón trả</th>
                    @if (Model.CanManage)
                    {
                        <th class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Employees.Any())
                {
                    <tr>
                        <td colspan="@(Model.CanManage ? 13 : 12)" class="text-center text-muted py-4">Không có dữ liệu CNV.</td>
                    </tr>
                }
                else
                {
                    for (var i = 0; i < Model.Employees.Count; i++)
                    {
                        var employee = Model.Employees[i];
                        <tr>
                            @if (Model.CanManage)
                            {
                                <td>
                                    <input type="checkbox" class="form-check-input js-employee-check" name="ids" value="@employee.ID" form="bulkDeleteEmployeeBusForm" />
                                </td>
                            }
                            <td>@(startIndex + i)</td>
                            <td>@employee.CHR_EMPLOYEE_ID</td>
                            <td>@employee.NVCHR_EMPLOYEE_NAME</td>
                            <td title="@employee.CHR_CODE_SEC">@Model.GetDepartmentName(employee.CHR_CODE_SEC)</td>
                            <td>@employee.CHR_PHONE</td>
                            <td>@employee.NVCHR_CITY</td>
                            <td>@employee.NVCHR_WARD</td>
                            <td>@employee.NVCHR_ADDRESS_DETAIL</td>
                            <td>@Model.GetEmployeePickupRouteDisplay(employee.ID)</td>
                            <td>@Model.GetEmployeeReturnRouteDisplay(employee.ID)</td>
                            <td>@Model.GetEmployeeRouteStopsDisplay(employee.ID)</td>
                            @if (Model.CanManage)
                            {
                                <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-primary ms-1 mb-1" data-bs-toggle="modal" data-bs-target="#editEmployeeBusModal-@employee.ID">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <form id="deleteEmployeeBusForm-@employee.ID" method="post" asp-controller="EmployeeBus" asp-action="Delete" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@employee.ID" />
                                            <input type="hidden" name="employeeCode" value="@Model.EmployeeCode" />
                                            <input type="hidden" name="employeeName" value="@Model.EmployeeName" />
                                            <input type="hidden" name="department" value="@Model.Department" />
                                            <input type="hidden" name="phone" value="@Model.Phone" />
                                            <input type="hidden" name="city" value="@Model.City" />
                                            <input type="hidden" name="ward" value="@Model.Ward" />
                                            <input type="hidden" name="busStopId" value="@Model.BusStopId" />
                                            <input type="hidden" name="page" value="@Model.PageNumber" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button class="btn btn-sm btn-danger js-action-button ms-1 mb-1" type="button"
                                                    data-form-id="deleteEmployeeBusForm-@employee.ID"
                                                    data-confirm-title="Xóa CNV"
                                                    data-confirm-message="Bạn có chắc chắn muốn xóa CNV này?">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="small text-muted mb-2">Hiển thị @startIndex - @endIndex / @Model.TotalCount</div>
    @await Html.PartialAsync("_Pagination", new
    {
        PageIndex = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        Action = "Index",
        Term = (string?)null,
        RouteExtras = new Dictionary<string, string?>
        {
            ["employeeCode"] = Model.EmployeeCode,
            ["employeeName"] = Model.EmployeeName,
            ["department"] = Model.Department,
            ["phone"] = Model.Phone,
            ["city"] = Model.City,
            ["ward"] = Model.Ward,
            ["busStopId"] = Model.BusStopId?.ToString()
        }
        })
</div>

<div class="modal fade dragable-modal" id="employeeRouteCapacityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-bus me-2 text-primary"></i>Dung lượng tuyến xe đang hoạt động</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="employeeRouteCapacityContainer" class="row g-3"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade dragable-modal" id="employeeRouteCapacityDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-route me-2 text-primary"></i>Chi tiết điểm đón trả</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="employeeRouteCapacityDetailBody"></div>
        </div>
    </div>
</div>

@if (Model.CanManage)
{
    <div class="modal fade dragable-modal" id="createEmployeeBusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm CNV sử dụng xe công ty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="EmployeeBus" asp-action="Create" class="js-post-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="SearchEmployeeCode" value="@Model.EmployeeCode" />
                        <input type="hidden" name="SearchEmployeeName" value="@Model.EmployeeName" />
                        <input type="hidden" name="SearchDepartment" value="@Model.Department" />
                        <input type="hidden" name="SearchPhone" value="@Model.Phone" />
                        <input type="hidden" name="SearchCity" value="@Model.City" />
                        <input type="hidden" name="SearchWard" value="@Model.Ward" />
                        <input type="hidden" name="SearchBusStopId" value="@Model.BusStopId" />
                        <input type="hidden" name="Page" value="@Model.PageNumber" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Mã NV</label>
                                <input class="form-control js-employee-code-autofill" name="EmployeeCode" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Họ và tên</label>
                                <input class="form-control" name="EmployeeName" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Phòng ban</label>
                                <select class="w-100 selectpicker" data-live-search="true" data-size="8" name="Department" title="-- Chọn phòng ban --">
                                    <option value="">-- Chọn phòng ban --</option>
                                    @foreach (var section in Model.Sections)
                                    {
                                        var secCode = section.CHR_CODE?.Trim();
                                        var secName = section.CHR_NAME ?? section.CHR_SECTION_NAME ?? secCode;
                                        if (string.IsNullOrWhiteSpace(secCode))
                                        {
                                            continue;
                                        }

                                        <option value="@secCode">@secName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">SĐT</label>
                                <input class="form-control" name="Phone" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Tỉnh</label>
                                <select class="form-select js-city-select" name="City">
                                    <option value="">-- Chọn tỉnh/thành --</option>
                                    @foreach (var cityOption in Model.Cities)
                                    {
                                        if (!string.IsNullOrWhiteSpace(cityOption.NVCHR_CITY_NAME))
                                        {
                                            var cityName = cityOption.NVCHR_CITY_NAME.Trim();
                                            <option value="@cityName" data-city-id="@cityOption.ID">@cityName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Xã</label>
                                <select class="form-select js-ward-select" name="Ward">
                                    <option value="">-- Chọn xã/phường --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-12">
                                <label class="form-label">Địa chỉ chi tiết</label>
                                <input class="form-control" name="AddressDetail" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="hidden" name="IsUseSameStopAndRoute" value="false" />
                                    <input class="form-check-input js-same-stop-route-toggle" type="checkbox" name="IsUseSameStopAndRoute" value="true" checked id="createUseSameStopRoute" />
                                    <label class="form-check-label" for="createUseSameStopRoute">
                                        Dùng chung điểm đón trả và tuyến xe
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Điểm đón</label>
                                <select class="selectpicker js-pickup-busstop-select" data-live-search="true" data-size="8" data-container="body" name="PickupStopId" title="-- Chọn điểm --">
                                    <option value="">-- Chọn điểm --</option>
                                    @foreach (var cityGroup in Model.BusStops.GroupBy(x => string.IsNullOrWhiteSpace(x.NVCHR_STOP_CITY) ? "Khác" : x.NVCHR_STOP_CITY).OrderBy(x => x.Key))
                                    {
                                        <optgroup label="@cityGroup.Key">
                                            @foreach (var busStop in cityGroup.OrderBy(x => x.NVCHR_STOP_WARD).ThenBy(x => x.NVCHR_STOP_NAME))
                                            {
                                                <option value="@busStop.ID">@Model.GetBusStopDisplayName(busStop.ID)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6 js-return-stop-container" style="display: none;">
                                <label class="form-label">Điểm trả</label>
                                <select class="selectpicker js-return-busstop-select" data-live-search="true" data-size="8" data-container="body" name="ReturnStopId" title="-- Chọn điểm --">
                                    <option value="">-- Chọn điểm --</option>
                                    @foreach (var cityGroup in Model.BusStops.GroupBy(x => string.IsNullOrWhiteSpace(x.NVCHR_STOP_CITY) ? "Khác" : x.NVCHR_STOP_CITY).OrderBy(x => x.Key))
                                    {
                                        <optgroup label="@cityGroup.Key">
                                            @foreach (var busStop in cityGroup.OrderBy(x => x.NVCHR_STOP_WARD).ThenBy(x => x.NVCHR_STOP_NAME))
                                            {
                                                <option value="@busStop.ID">@Model.GetBusStopDisplayName(busStop.ID)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Tuyến xe chiều đi</label>
                                <select class="form-select js-pickup-route-assign-select" name="PickupRouteAssignId" data-selected="">
                                    <option value="">-- Chọn tuyến xe --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 js-return-route-container" style="display: none;">
                                <label class="form-label">Tuyến xe chiều về</label>
                                <select class="form-select js-return-route-assign-select" name="ReturnRouteAssignId" data-selected="">
                                    <option value="">-- Chọn tuyến xe --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Lượt chiều đi</label>
                                <select class="form-select js-pickup-turn-select" name="PickupTurn">
                                    <option value="">-- Tự động xác định --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 js-return-turn-container" style="display: none;">
                                <label class="form-label">Lượt chiều về</label>
                                <select class="form-select js-return-turn-select" name="ReturnTurn">
                                    <option value="">-- Tự động xác định --</option>
                                </select>
                            </div>
                            <!-- Legacy fields for backward compatibility -->
                            <input type="hidden" name="BusStopId" class="js-legacy-bus-stop-id" />
                            <input type="hidden" name="RouteAssignId" class="js-legacy-route-assign-id" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
             </div>
         </div>
     </div>

     @foreach (var employee in Model.Employees)
     {
         <div class="modal fade dragable-modal" id="editEmployeeBusModal-@employee.ID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cập nhật CNV - @employee.NVCHR_EMPLOYEE_NAME</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-controller="EmployeeBus" asp-action="Update" class="js-post-form">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <input type="hidden" name="ID" value="@employee.ID" />
                            <input type="hidden" name="SearchEmployeeCode" value="@Model.EmployeeCode" />
                            <input type="hidden" name="SearchEmployeeName" value="@Model.EmployeeName" />
                            <input type="hidden" name="SearchDepartment" value="@Model.Department" />
                            <input type="hidden" name="SearchPhone" value="@Model.Phone" />
                            <input type="hidden" name="SearchCity" value="@Model.City" />
                            <input type="hidden" name="SearchWard" value="@Model.Ward" />
                            <input type="hidden" name="SearchBusStopId" value="@Model.BusStopId" />
                            <input type="hidden" name="Page" value="@Model.PageNumber" />
                            <input type="hidden" name="PageSize" value="@Model.PageSize" />

                            @{
                                var employeeRoute = Model.EmployeeRoutes.FirstOrDefault(r => r.INT_EMPLOYEE_ID == employee.ID && r.BIT_IS_ACTIVE);
                            }

                            <!-- Hidden data fields for route information -->
                            <input type="hidden" class="js-route-data-pickup-stop" value="@(employeeRoute?.INT_PICKUP_STOP_ID ?? 0)" />
                            <input type="hidden" class="js-route-data-return-stop" value="@(employeeRoute?.INT_RETURN_STOP_ID ?? 0)" />
                            <input type="hidden" class="js-route-data-pickup-route" value="@(employeeRoute?.INT_ROUTE_ASSIGN_PICKUP_ID ?? 0)" />
                            <input type="hidden" class="js-route-data-return-route" value="@(employeeRoute?.INT_ROUTE_ASSIGN_RETURN_ID ?? 0)" />
                            <input type="hidden" class="js-route-data-pickup-turn" value="@(employeeRoute?.INT_PICKUP_TURN.ToString() ?? "")" />
                            <input type="hidden" class="js-route-data-return-turn" value="@(employeeRoute?.INT_RETURN_TURN.ToString() ?? "")" />

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Mã NV</label>
                                    <input class="form-control js-employee-code-autofill" name="EmployeeCode" value="@employee.CHR_EMPLOYEE_ID" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Họ và tên</label>
                                    <input class="form-control" name="EmployeeName" value="@employee.NVCHR_EMPLOYEE_NAME" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Phòng ban</label>
                                    <select class="w-100 selectpicker" data-live-search="true" data-size="8" name="Department" title="-- Chọn phòng ban --">
                                        <option value="">-- Chọn phòng ban --</option>
                                        @foreach (var section in Model.Sections)
                                        {
                                            var secCode = section.CHR_CODE?.Trim();
                                            var secName = section.CHR_NAME ?? section.CHR_SECTION_NAME ?? secCode;
                                            if (string.IsNullOrWhiteSpace(secCode))
                                            {
                                                continue;
                                            }

                                            if (string.Equals(employee.CHR_CODE_SEC, secCode, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@secCode" selected>@secName</option>
                                            }
                                            else
                                            {
                                                <option value="@secCode">@secName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">SĐT</label>
                                    <input class="form-control" name="Phone" value="@employee.CHR_PHONE" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Tỉnh</label>
                                    <select class="form-select js-city-select" name="City">
                                        <option value="">-- Chọn tỉnh/thành --</option>
                                        @foreach (var cityOption in Model.Cities)
                                        {
                                            if (!string.IsNullOrWhiteSpace(cityOption.NVCHR_CITY_NAME))
                                            {
                                                var cityName = cityOption.NVCHR_CITY_NAME.Trim();
                                                if (string.Equals(employee.NVCHR_CITY, cityName, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <option value="@cityName" data-city-id="@cityOption.ID" selected>@cityName</option>
                                                }
                                                else
                                                {
                                                    <option value="@cityName" data-city-id="@cityOption.ID">@cityName</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Xã</label>
                                    <select class="form-select js-ward-select" name="Ward" data-selected-ward="@employee.NVCHR_WARD">
                                        <option value="">-- Chọn xã/phường --</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-12">
                                    <label class="form-label">Địa chỉ chi tiết</label>
                                    <input class="form-control" name="AddressDetail" value="@employee.NVCHR_ADDRESS_DETAIL" />
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input type="hidden" name="IsUseSameStopAndRoute" value="false" />
                                        <input class="form-check-input js-same-stop-route-toggle" type="checkbox" name="IsUseSameStopAndRoute" value="true" id="editUseSameStopRoute-@employee.ID" />
                                        <label class="form-check-label" for="editUseSameStopRoute-@employee.ID">
                                            Dùng chung điểm đón trả và tuyến xe
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Điểm đón</label>
                                    <select class="selectpicker js-pickup-busstop-select" data-live-search="true" data-size="8" data-container="body" name="PickupStopId" title="-- Chọn điểm --">
                                        <option value="">-- Chọn điểm --</option>
                                        @foreach (var cityGroup in Model.BusStops.GroupBy(x => string.IsNullOrWhiteSpace(x.NVCHR_STOP_CITY) ? "Khác" : x.NVCHR_STOP_CITY).OrderBy(x => x.Key))
                                        {
                                            <optgroup label="@cityGroup.Key">
                                                @foreach (var busStop in cityGroup.OrderBy(x => x.NVCHR_STOP_WARD).ThenBy(x => x.NVCHR_STOP_NAME))
                                                {
                                                    if (employee.INT_BUS_STOP_ID == busStop.ID)
                                                    {
                                                        <option value="@busStop.ID" selected>@Model.GetBusStopDisplayName(busStop.ID)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@busStop.ID">@Model.GetBusStopDisplayName(busStop.ID)</option>
                                                    }
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 js-return-stop-container" style="display: none;">
                                    <label class="form-label">Điểm trả</label>
                                    <select class="selectpicker js-return-busstop-select" data-live-search="true" data-size="8" data-container="body" name="ReturnStopId" title="-- Chọn điểm --">
                                        <option value="">-- Chọn điểm --</option>
                                        @foreach (var cityGroup in Model.BusStops.GroupBy(x => string.IsNullOrWhiteSpace(x.NVCHR_STOP_CITY) ? "Khác" : x.NVCHR_STOP_CITY).OrderBy(x => x.Key))
                                        {
                                            <optgroup label="@cityGroup.Key">
                                                @foreach (var busStop in cityGroup.OrderBy(x => x.NVCHR_STOP_WARD).ThenBy(x => x.NVCHR_STOP_NAME))
                                                {
                                                    if (employeeRoute?.INT_RETURN_STOP_ID == busStop.ID)
                                                    {
                                                        <option value="@busStop.ID" selected>@Model.GetBusStopDisplayName(busStop.ID)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@busStop.ID">@Model.GetBusStopDisplayName(busStop.ID)</option>
                                                    }
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Tuyến xe chiều đi</label>
                                    <select class="form-select js-pickup-route-assign-select" name="PickupRouteAssignId" data-selected="">
                                        <option value="">-- Chọn tuyến xe --</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 js-return-route-container" style="display: none;">
                                    <label class="form-label">Tuyến xe chiều về</label>
                                    <select class="form-select js-return-route-assign-select" name="ReturnRouteAssignId" data-selected="">
                                        <option value="">-- Chọn tuyến xe --</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Lượt chiều đi</label>
                                    <select class="form-select js-pickup-turn-select" name="PickupTurn">
                                        <option value="">-- Tự động xác định --</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6 js-return-turn-container" style="display: none;">
                                    <label class="form-label">Lượt chiều về</label>
                                    <select class="form-select js-return-turn-select" name="ReturnTurn">
                                        <option value="">-- Tự động xác định --</option>
                                    </select>
                                </div>
                                <!-- Legacy fields for backward compatibility -->
                                <input type="hidden" name="BusStopId" class="js-legacy-bus-stop-id" />
                                <input type="hidden" name="RouteAssignId" class="js-legacy-route-assign-id" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="modal fade dragable-modal" id="importEmployeeBusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Import CNV sử dụng xe công ty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="EmployeeBus" asp-action="Import" enctype="multipart/form-data" class="js-post-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="employeeCode" value="@Model.EmployeeCode" />
                        <input type="hidden" name="employeeName" value="@Model.EmployeeName" />
                        <input type="hidden" name="department" value="@Model.Department" />
                        <input type="hidden" name="phone" value="@Model.Phone" />
                        <input type="hidden" name="city" value="@Model.City" />
                        <input type="hidden" name="ward" value="@Model.Ward" />
                        <input type="hidden" name="busStopId" value="@Model.BusStopId" />
                        <input type="hidden" name="page" value="@Model.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />

                        <label class="form-label">Chọn file Excel/CSV</label>
                        <input type="file" name="importFile" class="form-control" accept=".xlsx,.csv" required />
                        <div class="small text-muted mt-2">
                            Định dạng: <code>EmployeeCode,EmployeeName,DepartmentCode,Phone,City,Ward,AddressDetail,BusStopId,IsActive</code>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success">Import</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (TempData["EmployeeBusSuccess"] is string successMessage)
    {
        <script>window.AppCommon && AppCommon.successTopRight(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));</script>
    }
    @if (TempData["EmployeeBusError"] is string errorMessage)
    {
        <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));</script>
    }

    <script>
        (function () {
            var cityData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Cities
                    .Where(x => !string.IsNullOrWhiteSpace(x.NVCHR_CITY_NAME))
                    .Select(x => new
                    {
                        id = x.ID,
                        name = x.NVCHR_CITY_NAME!.Trim()
                    })
                    .ToList()));

            var wardData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Wards
                    .Where(x => !string.IsNullOrWhiteSpace(x.NVCHR_WARD_NAME))
                    .Select(x => new
                    {
                        cityId = x.INT_CITY_ID,
                        name = x.NVCHR_WARD_NAME!.Trim()
                    })
                    .ToList()));

            var selectedSearchWard = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Ward));

            function ensureAntiForgery(form) {
                if (!form) return;
                var tokenInForm = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInForm) return;

                var globalToken = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!globalToken) return;

                var cloned = document.createElement('input');
                cloned.type = 'hidden';
                cloned.name = '__RequestVerificationToken';
                cloned.value = globalToken.value;
                form.appendChild(cloned);
            }

            function showLoading() {
                if (typeof window.showLoading === 'function') {
                    window.showLoading();
                }
            }

            function hideLoading() {
                if (typeof window.hideLoading === 'function') {
                    window.hideLoading();
                }
            }

            function normalizeText(value) {
                return (value || '').toString().trim().toLowerCase();
            }

            function resolveCityIdByName(cityName) {
                var normalized = normalizeText(cityName);
                if (!normalized) return null;

                for (var i = 0; i < cityData.length; i++) {
                    if (normalizeText(cityData[i].name) === normalized) {
                        return cityData[i].id;
                    }
                }

                return null;
            }

            function setSelectValue(selectEl, value, allowFallbackOption) {
                if (!selectEl) return;

                var normalizedValue = normalizeText(value);
                if (!normalizedValue) {
                    selectEl.value = '';
                    if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.select2 === 'function') {
                        try { window.jQuery(selectEl).val('').trigger('change'); } catch (e) { }
                    }
                    return;
                }

                var matchedOption = Array.prototype.find.call(selectEl.options, function (opt) {
                    return normalizeText(opt.value) === normalizedValue;
                });

                if (!matchedOption && allowFallbackOption) {
                    var fallback = document.createElement('option');
                    fallback.value = value;
                    fallback.text = value;
                    selectEl.appendChild(fallback);
                    matchedOption = fallback;
                }

                if (matchedOption) {
                    // Prefer select2 if available
                    if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.select2 === 'function' && selectEl.classList.contains('selectpicker')) {
                        var $select = window.jQuery(selectEl);
                        try { $select.val(matchedOption.value).trigger('change'); } catch (e) { selectEl.value = matchedOption.value; }
                    } else {
                        selectEl.value = matchedOption.value;
                    }
                }

                // If selectpicker library is still used, refresh it as fallback
                if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.selectpicker === 'function' && selectEl.classList.contains('selectpicker')) {
                    var $sp = window.jQuery(selectEl);
                    try { $sp.selectpicker('render'); $sp.selectpicker('refresh'); } catch (e) { }
                }
            }

            function initSelect2(container) {
                if (!window.jQuery || typeof window.jQuery.fn.select2 !== 'function') return;
                var $container = container ? window.jQuery(container) : window.jQuery(document);
                $container.find('.selectpicker').each(function () {
                    var $el = window.jQuery(this);
                    if ($el.data('select2')) return;
                    try {
                        // If inside a modal, use the modal's .modal-content as dropdownParent to avoid focus/scroll issues
                        var $modal = $el.closest('.modal');
                        var $dropdownParent = ($modal && $modal.length) ? $modal.find('.modal-content').first() : window.jQuery(document.body);
                        $el.select2({
                            width: '100%',
                            theme: (window.jQuery.fn.select2.defaults && window.jQuery.fn.select2.defaults.theme) ? window.jQuery.fn.select2.defaults.theme : 'classic',
                            dropdownParent: $dropdownParent
                        });
                        // ensure the search input in dropdown is focusable inside modals
                        $el.on('select2:open', function () {
                            try {
                                var $search = window.jQuery('.select2-container--open .select2-search__field');
                                if ($search && $search.length) {
                                    $search.first().focus();
                                }
                            } catch (e) { }
                        });
                    } catch (e) {
                        // ignore
                    }
                });
            }

            function buildWardOptions(wardSelect, cityName, selectedWardName) {
                if (!wardSelect) return;

                var cityId = resolveCityIdByName(cityName);
                var normalizedSelectedWard = normalizeText(selectedWardName);
                var allowEmpty = wardSelect.dataset.allowEmpty === 'true';

                while (wardSelect.options.length > 0) {
                    wardSelect.remove(0);
                }

                var defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.text = allowEmpty ? 'Tất cả xã/phường' : '-- Chọn xã/phường --';
                wardSelect.appendChild(defaultOption);

                var availableWards = wardData.filter(function (x) {
                    if (!x || !x.name) return false;
                    return cityId != null && x.cityId === cityId;
                });

                var uniqueWardMap = new Map();
                availableWards.forEach(function (item) {
                    var key = normalizeText(item.name);
                    if (!uniqueWardMap.has(key)) {
                        uniqueWardMap.set(key, item.name);
                    }
                });

                Array.from(uniqueWardMap.values())
                    .sort(function (a, b) { return a.localeCompare(b); })
                    .forEach(function (wardName) {
                        var option = document.createElement('option');
                        option.value = wardName;
                        option.text = wardName;
                        if (normalizeText(wardName) === normalizedSelectedWard) {
                            option.selected = true;
                        }
                        wardSelect.appendChild(option);
                    });

                if (!wardSelect.value && normalizedSelectedWard) {
                    var fallback = document.createElement('option');
                    fallback.value = selectedWardName;
                    fallback.text = selectedWardName;
                    fallback.selected = true;
                    wardSelect.appendChild(fallback);
                }
            }

            function wireCityWardSelect(form) {
                if (!form) return;

                var citySelect = form.querySelector('.js-city-select');
                var wardSelect = form.querySelector('.js-ward-select');
                if (!citySelect || !wardSelect) return;

                var initialSelectedWard = wardSelect.dataset.selectedWard || '';
                if (wardSelect.id === 'searchWardSelect') {
                    initialSelectedWard = selectedSearchWard || '';
                }

                buildWardOptions(wardSelect, citySelect.value, initialSelectedWard);

                citySelect.addEventListener('change', function () {
                    buildWardOptions(wardSelect, citySelect.value, '');
                });
            }

            document.querySelectorAll('form').forEach(function (form) {
                wireCityWardSelect(form);
                // initialize select2 on form if available
                try { initSelect2(form); } catch (e) { }
            });

            document.querySelectorAll('form.js-search-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                });
            });

            document.querySelectorAll('form.js-export-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoading();
                    setTimeout(function () {
                        hideLoading();
                    }, 2500);
                });
            });

            async function fillRouteAssignOptions(form) {
                if (!form) return;
                var routeSelect = form.querySelector('.js-route-assign-select');
                if (!routeSelect) return;

                var busStopSelect = form.querySelector('select[name="BusStopId"]');
                var busStopId = busStopSelect ? (busStopSelect.value || '') : '';
                var selected = routeSelect.getAttribute('data-selected') || routeSelect.value || '';

                routeSelect.innerHTML = '<option value="">-- Chọn tuyến xe --</option>';
                try {
                    var response = await fetch('@Url.Action("GetActiveRouteAssignOptions", "EmployeeBus")?busStopId=' + encodeURIComponent(busStopId));
                    if (!response.ok) return;
                    var items = await response.json();
                    (items || []).forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.displayName;
                        if (selected && String(item.id) === String(selected)) {
                            opt.selected = true;
                        }
                        routeSelect.appendChild(opt);
                    });
                } catch (err) {
                    console.warn('Cannot load route assign options', err);
                }
            }

            async function fillPickupRouteOptions(form) {
                if (!form) return;
                var pickupRouteSelect = form.querySelector('.js-pickup-route-assign-select');
                if (!pickupRouteSelect) return;

                var pickupStopSelect = form.querySelector('select.js-pickup-busstop-select');
                var pickupStopId = pickupStopSelect ? (pickupStopSelect.value || '') : '';
                var selected = pickupRouteSelect.getAttribute('data-selected') || pickupRouteSelect.value || '';

                if (pickupRouteSelect._abortCtrl) {
                    pickupRouteSelect._abortCtrl.abort();
                }
                var controller = new AbortController();
                pickupRouteSelect._abortCtrl = controller;

                pickupRouteSelect.innerHTML = '<option value="">-- Chọn tuyến xe --</option>';
                try {
                    var response = await fetch(
                        '@Url.Action("GetActiveRouteAssignOptions", "EmployeeBus")?busStopId=' + encodeURIComponent(pickupStopId),
                        { signal: controller.signal }
                    );
                    if (!response.ok) return;
                    var items = await response.json();

                    if (pickupRouteSelect._abortCtrl !== controller) return;

                    (items || []).forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.displayName;
                        if (selected && String(item.id) === String(selected)) {
                            opt.selected = true;
                        }
                        pickupRouteSelect.appendChild(opt);
                    });
                    pickupRouteSelect.dispatchEvent(new Event('change', { bubbles: true }));
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.warn('Cannot load pickup route assign options', err);
                    }
                }
            }

            async function fillReturnRouteOptions(form) {
                if (!form) return;
                var returnRouteSelect = form.querySelector('.js-return-route-assign-select');
                if (!returnRouteSelect) return;

                var returnStopSelect = form.querySelector('select.js-return-busstop-select');
                var returnStopId = returnStopSelect ? (returnStopSelect.value || '') : '';
                var selected = returnRouteSelect.getAttribute('data-selected') || returnRouteSelect.value || '';

                // Huỷ request trước đó (nếu còn đang chạy) để tránh nó ghi đè kết quả mới
                if (returnRouteSelect._abortCtrl) {
                    returnRouteSelect._abortCtrl.abort();
                }
                var controller = new AbortController();
                returnRouteSelect._abortCtrl = controller;

                returnRouteSelect.innerHTML = '<option value="">-- Chọn tuyến xe --</option>';
                try {
                    var response = await fetch(
                        '@Url.Action("GetActiveRouteAssignOptions", "EmployeeBus")?busStopId=' + encodeURIComponent(returnStopId),
                        { signal: controller.signal }
                    );
                    if (!response.ok) return;
                    var items = await response.json();

                    // Nếu trong lúc chờ, đã có 1 request mới hơn được gửi -> bỏ qua kết quả cũ này
                    if (returnRouteSelect._abortCtrl !== controller) return;

                    (items || []).forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.displayName;
                        if (selected && String(item.id) === String(selected)) {
                            opt.selected = true;
                        }
                        returnRouteSelect.appendChild(opt);
                    });
                    returnRouteSelect.dispatchEvent(new Event('change', { bubbles: true }));
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.warn('Cannot load return route assign options', err);
                    }
                }
            }

            async function fillPickupTurnOptions(form) {
                if (!form) return;
                var pickupTurnSelect = form.querySelector('.js-pickup-turn-select');
                if (!pickupTurnSelect) return;

                var pickupStopSelect = form.querySelector('select.js-pickup-busstop-select');
                var pickupRouteSelect = form.querySelector('.js-pickup-route-assign-select');
                var pickupStopId = pickupStopSelect ? (pickupStopSelect.value || '') : '';
                var pickupRouteId = pickupRouteSelect ? (pickupRouteSelect.value || '') : '';
                var selectedTurn = pickupTurnSelect.getAttribute('data-selected-turn') || '';

                if (pickupTurnSelect._abortCtrl) {
                    pickupTurnSelect._abortCtrl.abort();
                }
                var controller = new AbortController();
                pickupTurnSelect._abortCtrl = controller;

                pickupTurnSelect.innerHTML = '<option value="">-- Tự động xác định --</option>';

                if (!pickupStopId || !pickupRouteId) {
                    console.log('[fillPickupTurnOptions] Missing pickupStopId or pickupRouteId', { pickupStopId, pickupRouteId });
                    return;
                }

                try {
                    var response = await fetch(
                        '@Url.Action("GetBusStopTurns", "EmployeeBus")?' +
                        'routeAssignId=' + encodeURIComponent(pickupRouteId) +
                        '&busStopId=' + encodeURIComponent(pickupStopId) +
                        '&direction=1',
                        { signal: controller.signal }
                    );
                    if (!response.ok) {
                        console.warn('[fillPickupTurnOptions] Response not ok:', response.status);
                        return;
                    }
                    var items = await response.json();

                    if (pickupTurnSelect._abortCtrl !== controller) return;

                    console.log('[fillPickupTurnOptions] Loaded turns:', items, 'selectedTurn:', selectedTurn);
                    (items || []).forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.turn;
                        opt.textContent = 'Lượt ' + item.turn + (item.turnName ? ' - ' + item.turnName : '');
                        if (selectedTurn && String(item.turn) === String(selectedTurn)) {
                            opt.selected = true;
                        }
                        pickupTurnSelect.appendChild(opt);
                    });
                    pickupTurnSelect.removeAttribute('data-selected-turn');
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.warn('[fillPickupTurnOptions] Error:', err);
                    }
                }
            }

            async function fillReturnTurnOptions(form) {
                if (!form) return;
                var returnTurnSelect = form.querySelector('.js-return-turn-select');
                if (!returnTurnSelect) return;

                var returnStopSelect = form.querySelector('select.js-return-busstop-select');
                var returnRouteSelect = form.querySelector('.js-return-route-assign-select');
                var returnStopId = returnStopSelect ? (returnStopSelect.value || '') : '';
                var returnRouteId = returnRouteSelect ? (returnRouteSelect.value || '') : '';
                var selectedTurn = returnTurnSelect.getAttribute('data-selected-turn') || '';

                if (returnTurnSelect._abortCtrl) {
                    returnTurnSelect._abortCtrl.abort();
                }
                var controller = new AbortController();
                returnTurnSelect._abortCtrl = controller;

                returnTurnSelect.innerHTML = '<option value="">-- Tự động xác định --</option>';

                if (!returnStopId || !returnRouteId) {
                    console.log('[fillReturnTurnOptions] Missing returnStopId or returnRouteId', { returnStopId, returnRouteId });
                    return;
                }

                try {
                    var response = await fetch(
                        '@Url.Action("GetBusStopTurns", "EmployeeBus")?' +
                        'routeAssignId=' + encodeURIComponent(returnRouteId) +
                        '&busStopId=' + encodeURIComponent(returnStopId) +
                        '&direction=2',
                        { signal: controller.signal }
                    );
                    if (!response.ok) {
                        console.warn('[fillReturnTurnOptions] Response not ok:', response.status);
                        return;
                    }
                    var items = await response.json();

                    if (returnTurnSelect._abortCtrl !== controller) return;

                    console.log('[fillReturnTurnOptions] Loaded turns:', items, 'selectedTurn:', selectedTurn);
                    (items || []).forEach(function (item) {
                        var opt = document.createElement('option');
                        opt.value = item.turn;
                        opt.textContent = 'Lượt ' + item.turn + (item.turnName ? ' - ' + item.turnName : '');
                        if (selectedTurn && String(item.turn) === String(selectedTurn)) {
                            opt.selected = true;
                        }
                        returnTurnSelect.appendChild(opt);
                    });
                    returnTurnSelect.removeAttribute('data-selected-turn');
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.warn('[fillReturnTurnOptions] Error:', err);
                    }
                }
            }

            function wireRouteAssignByStop(form) {
                if (!form) return;
                var busStopSelect = form.querySelector('select[name="BusStopId"]');
                var routeSelect = form.querySelector('.js-route-assign-select');
                if (!routeSelect) return;

                fillRouteAssignOptions(form);

                if (busStopSelect) {
                    busStopSelect.addEventListener('change', function () {
                        routeSelect.setAttribute('data-selected', '');
                        fillRouteAssignOptions(form);
                    });

                    if (window.jQuery) {
                        // support select2/selectpicker by listening to change
                        window.jQuery(busStopSelect).off('change.routeByStop').on('change.routeByStop', function () {
                            routeSelect.setAttribute('data-selected', '');
                            fillRouteAssignOptions(form);
                        });
                    }
                }
            }

            function wirePickupReturnStopAndRoute(form) {
                if (!form) return;

                var pickupStopSelect = form.querySelector('select.js-pickup-busstop-select');
                var returnStopSelect = form.querySelector('select.js-return-busstop-select');
                var pickupRouteSelect = form.querySelector('.js-pickup-route-assign-select');
                var returnRouteSelect = form.querySelector('.js-return-route-assign-select');
                var pickupTurnSelect = form.querySelector('.js-pickup-turn-select');
                var returnTurnSelect = form.querySelector('.js-return-turn-select');
                var sameStopRouteToggle = form.querySelector('.js-same-stop-route-toggle');
                var returnStopContainer = form.querySelector('.js-return-stop-container');
                var returnRouteContainer = form.querySelector('.js-return-route-container');
                var returnTurnContainer = form.querySelector('.js-return-turn-container');
                var legacyBusStopInput = form.querySelector('.js-legacy-bus-stop-id');
                var legacyRouteInput = form.querySelector('.js-legacy-route-assign-id');

                if (!pickupStopSelect || !pickupRouteSelect) return;

                function updateVisibility() {
                    var useSame = sameStopRouteToggle ? sameStopRouteToggle.checked : true;
                    if (returnStopContainer) returnStopContainer.style.display = useSame ? 'none' : 'block';
                    if (returnRouteContainer) returnRouteContainer.style.display = useSame ? 'none' : 'block';
                    if (returnTurnContainer) returnTurnContainer.style.display = useSame ? 'none' : 'block';

                    if (useSame) {
                        if (returnStopSelect) returnStopSelect.value = pickupStopSelect.value;
                        if (returnRouteSelect) returnRouteSelect.value = pickupRouteSelect.value;
                        if (returnTurnSelect) returnTurnSelect.value = pickupTurnSelect ? (pickupTurnSelect.value || '') : '';
                    }
                }

                function updateLegacyFields() {
                    var useSame = sameStopRouteToggle ? sameStopRouteToggle.checked : true;
                    if (legacyBusStopInput) {
                        legacyBusStopInput.value = pickupStopSelect.value || '';
                    }
                    if (legacyRouteInput) {
                        legacyRouteInput.value = (useSame ? pickupRouteSelect.value : returnRouteSelect.value) || '';
                    }
                }

                // Initial setup - load routes first
                fillPickupRouteOptions(form);
                fillReturnRouteOptions(form);
                updateVisibility();
                updateLegacyFields();

                // Auto-detect if using same stop and route (don't need to do again as it was set in populateEditModalFromRoute)

                // Handle pickup stop change
                if (window.jQuery) {
                    window.jQuery(pickupStopSelect).off('change.pickupStop').on('change.pickupStop', function () {
                        fillPickupRouteOptions(form);
                        fillPickupTurnOptions(form);
                        updateVisibility();
                        updateLegacyFields();
                    });
                } else {
                    pickupStopSelect.addEventListener('change', function () {
                        fillPickupRouteOptions(form);
                        fillPickupTurnOptions(form);
                        updateVisibility();
                        updateLegacyFields();
                    });
                }

                // Handle return stop change
                if (returnStopSelect) {
                    if (window.jQuery) {
                        window.jQuery(returnStopSelect).off('change.returnStop').on('change.returnStop', function () {
                            fillReturnRouteOptions(form);
                            fillReturnTurnOptions(form);
                            updateLegacyFields();
                        });
                    } else {
                        returnStopSelect.addEventListener('change', function () {
                            fillReturnRouteOptions(form);
                            fillReturnTurnOptions(form);
                            updateLegacyFields();
                        });
                    }
                }

                // Handle pickup route change
                window.jQuery(pickupRouteSelect).off('change.routeWire').on('change.routeWire', function () {
                    fillPickupTurnOptions(form);
                    updateVisibility();
                    updateLegacyFields();
                });

                // Handle return route change
                if (returnRouteSelect) {
                    window.jQuery(returnRouteSelect).off('change.returnRouteWire').on('change.returnRouteWire', function () {
                        fillReturnTurnOptions(form);
                        updateLegacyFields();
                    });
                }

                // Handle same stop/route toggle
                if (sameStopRouteToggle) {
                    window.jQuery(sameStopRouteToggle).off('change.routeWire').on('change.routeWire', function () {
                        updateVisibility();
                        updateLegacyFields();
                    });
                }

                // Handle same stop/route toggle
                if (sameStopRouteToggle) {
                    sameStopRouteToggle.removeEventListener('change', arguments.callee);
                    sameStopRouteToggle.addEventListener('change', function () {
                        updateVisibility();
                        updateLegacyFields();
                    });
                }

                // After a delay, load turn options (to ensure routes have been loaded)
                setTimeout(function () {
                    fillPickupTurnOptions(form);
                    fillReturnTurnOptions(form);
                }, 300);
            }

            document.querySelectorAll('#createEmployeeBusModal form').forEach(function (form) {
                try { initSelect2(form); } catch (e) { }
                wireRouteAssignByStop(form);
                wirePickupReturnStopAndRoute(form);
            });

            function populateEditModalFromRoute(form) {
                if (!form) return;

                var pickupStopInput = form.querySelector('.js-route-data-pickup-stop');
                var returnStopInput = form.querySelector('.js-route-data-return-stop');
                var pickupRouteInput = form.querySelector('.js-route-data-pickup-route');
                var returnRouteInput = form.querySelector('.js-route-data-return-route');
                var pickupTurnInput = form.querySelector('.js-route-data-pickup-turn');
                var returnTurnInput = form.querySelector('.js-route-data-return-turn');

                if (!pickupStopInput) return;

                var pickupStopId = parseInt(pickupStopInput.value || '0', 10);
                var returnStopId = parseInt(returnStopInput.value || '0', 10);
                var pickupRouteId = parseInt(pickupRouteInput.value || '0', 10);
                var returnRouteId = parseInt(returnRouteInput.value || '0', 10);
                var pickupTurn = pickupTurnInput.value || '';
                var returnTurn = returnTurnInput.value || '';

                // Only populate if there's valid route data
                if (pickupStopId <= 0 && pickupRouteId <= 0) return;

                var pickupStopSelect = form.querySelector('select.js-pickup-busstop-select');
                var returnStopSelect = form.querySelector('select.js-return-busstop-select');
                var pickupRouteSelect = form.querySelector('.js-pickup-route-assign-select');
                var returnRouteSelect = form.querySelector('.js-return-route-assign-select');
                var pickupTurnSelect = form.querySelector('.js-pickup-turn-select');
                var returnTurnSelect = form.querySelector('.js-return-turn-select');
                var sameStopRouteToggle = form.querySelector('.js-same-stop-route-toggle');

                // Determine if using same stop/route
                var isSameStopRoute = (pickupStopId === returnStopId && pickupRouteId === returnRouteId);

                // Set checkbox state FIRST
                if (sameStopRouteToggle) {
                    sameStopRouteToggle.checked = isSameStopRoute;
                }

                // Set pickup stop and trigger change event
                if (pickupStopId > 0 && pickupStopSelect) {
                    if (window.jQuery && typeof window.jQuery.fn.select2 === 'function') {
                        var $pickupStop = window.jQuery(pickupStopSelect);
                        try { $pickupStop.val(pickupStopId.toString()).trigger('change'); } catch (e) { pickupStopSelect.value = pickupStopId.toString(); }
                    } else {
                        pickupStopSelect.value = pickupStopId.toString();
                    }
                }

                // Set return stop (always set it, visibility is controlled by toggle)
                if (returnStopId > 0 && returnStopSelect) {
                    if (window.jQuery && typeof window.jQuery.fn.select2 === 'function') {
                        var $returnStop = window.jQuery(returnStopSelect);
                        try { $returnStop.val(returnStopId.toString()).trigger('change'); } catch (e) { returnStopSelect.value = returnStopId.toString(); }
                    } else {
                        returnStopSelect.value = returnStopId.toString();
                    }
                }

                // Set pickup route and store IDs for async loading; turns stored for later
                if (pickupRouteId > 0 && pickupRouteSelect) {
                    pickupRouteSelect.setAttribute('data-selected', pickupRouteId.toString());
                    if (pickupTurn) {
                        pickupTurnSelect.setAttribute('data-selected-turn', pickupTurn);
                    }
                }

                // Set return route and store IDs for async loading; turns stored for later
                if (returnRouteId > 0 && returnRouteSelect) {
                    returnRouteSelect.setAttribute('data-selected', returnRouteId.toString());
                    if (returnTurn) {
                        returnTurnSelect.setAttribute('data-selected-turn', returnTurn);
                    }
                }
            }

            function wireEditModalShow() {
                document.querySelectorAll('[id^="editEmployeeBusModal-"]').forEach(function (modal) {
                    modal.addEventListener('show.bs.modal', function () {
                        var form = modal.querySelector('form');
                        if (!form) return;

                        // First populate the data
                        populateEditModalFromRoute(form);
                        // initialize select2 for this form (if available)
                        try { initSelect2(form); } catch (e) { }
                        // Then after a delay, trigger the wiring and load route/turn options
                        setTimeout(function () {
                            wirePickupReturnStopAndRoute(form);
                        }, 150);
                    });
                });
            }

            wireEditModalShow();


            async function loadRouteCapacities() {
                var container = document.getElementById('employeeRouteCapacityContainer');
                if (!container) return;

                container.innerHTML = '<div class="col-12 text-center text-muted py-4">Đang tải dữ liệu...</div>';
                try {
                    var response = await fetch('@Url.Action("GetActiveRouteCapacities", "EmployeeBus")');
                    if (!response.ok) throw new Error('load fail');
                    var rows = await response.json();
                    if (!Array.isArray(rows) || !rows.length) {
                        container.innerHTML = '<div class="col-12 text-center text-muted py-4">Không có tuyến xe đang hoạt động.</div>';
                        return;
                    }

                    container.innerHTML = rows.map(function (item) {
                        var level = item.level || 'secondary';
                        var percentRaw = Math.max(0, Number(item.percentRaw || 0));
                        var percentBar = Math.max(0, Math.min(100, Number(item.percentBar || 0)));
                        return '<div class="col-12 col-md-6">'
                            + '<div class="border rounded-3 p-3 h-100">'
                            + '<div class="d-flex justify-content-between align-items-start mb-2">'
                            + '<div class="fw-semibold"><i class="fa-solid fa-bus text-' + level + ' me-2"></i>' + (item.routeDisplay || '') + '</div>'
                            + '<span class="badge bg-' + level + '">' + (item.currentUser || 0) + '/' + (item.capacity || 0) + '</span>'
                            + '</div>'
                            + '<div class="progress" style="height: 12px;"><div class="progress-bar bg-' + level + '" style="width:' + percentBar.toFixed(1) + '%"></div></div>'
                            + '<div class="small text-muted mt-2">Mức sử dụng: <strong>' + percentRaw.toFixed(1) + '%</strong></div>'
                            + '<div class="mt-2"><button type="button" class="btn btn-sm btn-outline-primary js-employee-route-detail" data-assign-id="' + item.id + '"><i class="fa-solid fa-list me-1"></i>Chi tiết tuyến</button></div>'
                            + '</div>'
                            + '</div>';
                    }).join('');
                } catch {
                    container.innerHTML = '<div class="col-12"><div class="alert alert-danger mb-0">Không thể tải dữ liệu dung lượng tuyến.</div></div>';
                }
            }

