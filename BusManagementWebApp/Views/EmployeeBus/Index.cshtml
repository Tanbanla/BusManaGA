            async function resolveEmployeeInfo(form) {
                if (!form) return;
                var employeeCodeInput = form.querySelector('input[name="EmployeeCode"]');
                if (!employeeCodeInput) return;

                var employeeCode = (employeeCodeInput.value || '').trim();
                if (!employeeCode) return;

                console.group('[EmployeeBus][AutoFill] ResolveEmployeeInfo');
                console.log('employeeCode:', employeeCode);

                try {
                    var url = '@Url.Action("ResolveEmployeeByCode", "EmployeeBus")' + '?employeeCode=' + encodeURIComponent(employeeCode);
                    console.log('requestUrl:', url);
                    var response = await fetch(url, { method: 'GET' });
                    console.log('response.ok:', response.ok, 'status:', response.status);
                    if (!response.ok) {
                        console.warn('Request failed');
                        console.groupEnd();
                        return;
                    }

                    var result = await response.json();
                    console.log('responseData:', result);
                    if (!result || !result.success || !result.data) {
                        console.warn('Invalid response payload');
                        console.groupEnd();
                        return;
                    }

                    var employeeNameInput = form.querySelector('input[name="EmployeeName"]');
                    var departmentInput = form.querySelector('[name="Department"]');
                    var phoneInput = form.querySelector('input[name="Phone"]');
                    var cityInput = form.querySelector('input[name="City"]');
                    var citySelect = form.querySelector('select[name="City"]');
                    var wardInput = form.querySelector('input[name="Ward"]');
                    var wardSelect = form.querySelector('select[name="Ward"]');
                    var addressDetailInput = form.querySelector('input[name="AddressDetail"]');

                    console.log('inputsFound:', {
                        employeeNameInput: !!employeeNameInput,
                        departmentInput: !!departmentInput,
                        phoneInput: !!phoneInput,
                        cityInput: !!cityInput,
                        citySelect: !!citySelect,
                        wardInput: !!wardInput,
                        wardSelect: !!wardSelect,
                        addressDetailInput: !!addressDetailInput
                    });

                    if (employeeNameInput) employeeNameInput.value = result.data.employeeName || '';
                    if (departmentInput) {
                        var departmentCode = (result.data.departmentCode || '').trim();
                        console.log('departmentCodeFromApi:', departmentCode);

                        if (departmentCode && departmentInput.tagName === 'SELECT') {
                            console.log('departmentSelect options count:', departmentInput.options.length);
                            var exists = Array.prototype.some.call(departmentInput.options, function (opt) {
                                return (opt.value || '').trim().toLowerCase() === departmentCode.trim().toLowerCase();
                            });

                            console.log('departmentCode exists in options:', exists);

                            if (!exists) {
                                var fallbackOption = document.createElement('option');
                                fallbackOption.value = departmentCode;
                                fallbackOption.text = departmentCode;
                                departmentInput.appendChild(fallbackOption);
                                console.log('fallback option appended:', departmentCode);
                            }
                        }

                        if (departmentInput.tagName === 'SELECT') {
                            var $department = window.jQuery ? window.jQuery(departmentInput) : null;
                            if ($department && typeof $department.select2 === 'function') {
                                try {
                                    $department.val(departmentCode).trigger('change');
                                } catch (e) {
                                    departmentInput.value = departmentCode;
                                }
                            } else if ($department && typeof $department.selectpicker === 'function') {
                                departmentInput.value = departmentCode;
                                try { $department.selectpicker('val', departmentCode); $department.selectpicker('render'); $department.selectpicker('refresh'); $department.trigger('changed.bs.select'); } catch (e) { }
                            } else {
                                departmentInput.value = departmentCode;
                            }
                        } else {
                            departmentInput.value = departmentCode;
                        }
                    }
                    if (phoneInput) phoneInput.value = result.data.phone || '';

                    if (citySelect) {
                        setSelectValue(citySelect, result.data.city || '', true);
                    } else if (cityInput) {
                        cityInput.value = result.data.city || '';
                    }

                    if (wardSelect) {
                        var cityValueForWard = citySelect ? citySelect.value : (cityInput ? cityInput.value : '');
                        buildWardOptions(wardSelect, cityValueForWard, result.data.ward || '');
                    } else if (wardInput) {
                        wardInput.value = result.data.ward || '';
                    }

                    if (addressDetailInput) addressDetailInput.value = result.data.addressDetail || '';
                    console.log('final values:', {
                        employeeName: employeeNameInput ? employeeNameInput.value : null,
                        department: departmentInput ? departmentInput.value : null,
                        phone: phoneInput ? phoneInput.value : null,
                        city: citySelect ? citySelect.value : (cityInput ? cityInput.value : null),
                        ward: wardSelect ? wardSelect.value : (wardInput ? wardInput.value : null),
                        addressDetail: addressDetailInput ? addressDetailInput.value : null
                    });
                } catch (err) {
                    console.error('[EmployeeBus][AutoFill] Error:', err);
                } finally {
                    console.groupEnd();
                }
            }

