@using BusManagement.Model

@model NotCardViewModel

@{
    ViewData["Title"] = "Danh sách CNV chưa có thẻ";
    var sections = ViewBag.Sections as IEnumerable<BusManagement.Model.Dtos.TM_SECTIONDTO> ?? Enumerable.Empty<BusManagement.Model.Dtos.TM_SECTIONDTO>();
    var startIndex = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize + 1);
    var endIndex = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

<style>
    .notcard-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }

        .notcard-card .table thead th {
            white-space: nowrap;
            vertical-align: middle;
            text-align: center;
        }

    .notcard-actions .btn {
        min-width: 110px;
    }

    .confirm-cell {
        color: #b91c1c;
        font-weight: 600;
        text-align: center;
    }

    .table-checkbox {
        width: 40px;
    }

    .action-buttons .btn {
        min-width: 60px;
    }
</style>

<div class="notcard-card p-3 p-md-4"
     data-deleteCardNots-url="@Url.Action("DeleteCardPrintQueues", "CardCar")"
     data-printCard-url="@Url.Action("PrintCards", "CardCar")">

    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <div>
            <h5 class="m-0">Danh sách CNV chưa có thẻ</h5>
            <div class="small text-muted">Quản lý nhân viên chưa có thẻ và chọn danh sách để in thẻ</div>
        </div>
    </div>

    <form method="get" asp-controller="CardCar" asp-action="NotCard" class="row g-2 mb-3 js-search-form">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="col-12 col-md-6 col-lg-3">
            <input class="form-control" name="employeeId" value="@Model.EmployeeId" placeholder="Mã nhân viên" />
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <select class="form-select" name="department">
                <option value="">Tất cả phòng ban</option>
                @foreach (var sec in sections)
                {
                    if (Model.Department == sec.CHR_CODE)
                    {
                        <option value="@sec.CHR_CODE" selected>@sec.CHR_NAME</option>
                    }
                    else
                    {
                        <option value="@sec.CHR_CODE">@sec.CHR_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-5 d-grid d-md-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="fa-solid fa-magnifying-glass me-1"></i>Tìm kiếm
            </button>
            <button type="button" class="btn btn-secondary flex-fill js-btn-reset">
                <i class="fa-solid fa-rotate-right me-1"></i>Làm mới
            </button>
            <div class="d-flex gap-2 flex-fill">
                <button type="button" class="btn btn-success flex-fill js-btn-print"
                        id="btnBulkPrint" disabled>
                    <i class="fa-solid fa-print me-1"></i>In nhiều
                </button>
                <button type="button"
                        class="btn btn-danger flex-fill js-btn-delete"
                        id="btnBulkDelete"
                        data-confirm-title="Xóa nhiều"
                        data-confirm-message="Bạn có chắc chắn muốn xóa các bản ghi đã chọn?"
                        disabled>
                    <i class="fa-solid fa-trash-can me-1"></i>Xóa nhiều
                </button>
            </div>
        </div>
    </form>

    <form id="bulkPrintForm" method="post" asp-controller="CardCar" asp-action="PrintCards"
          class="js-confirm js-require-selection"
          data-confirm-title="In nhiều thẻ"
          data-confirm-message="Bạn có chắc chắn muốn in các thẻ đã chọn?">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
        <input type="hidden" name="department" value="@Model.Department" />
        <input type="hidden" name="page" value="@Model.PageNumber" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="table-checkbox"><input id="chkAll" type="checkbox" class="form-check-input" form="bulkPrintForm" /></th>
                    <th width="60">STT</th>
                    <th>Mã nhân viên</th>
                    <th>Phòng ban</th>
                    <th>Họ và tên</th>
                    <th>Số xe chiều đón và chiều về</th>
                    <th>Điểm đón/trả</th>
                    <th>Xác nhận</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.NotCards.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Không có dữ liệu nhân viên chưa có thẻ.</td>
                    </tr>
                }
                else
                {
                    var index = 0;
                    foreach (var emp in Model.NotCards)
                    {
                        var sectionName = sections
                        .FirstOrDefault(x => x.CHR_CODE == emp.CHR_CODE_SEC)
                        ?.CHR_NAME ?? emp.CHR_CODE_SEC;
                        index++;
                        var stt = (Model.PageNumber - 1) * Model.PageSize + index;

                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input js-print-check"
                                       name="ids" value="@emp.ID" form="bulkPrintForm" />
                            </td>
                            <td class="text-center">@stt</td>
                            <td>@emp.CHR_EMPLOYEE_ID</td>
                            <td>@sectionName</td>
                            <td>@emp.NVCHR_EMPLOYEE_NAME</td>
                            <td>
                                Xe đi: @emp.PICKUP_ROUTE_NAME - Xe về: @emp.RETURN_ROUTE_NAME
                            </td>
                            <td>
                                Điểm đón: @emp.PICKUP_STOP_NAME - Điểm trả: @emp.RETURN_STOP_NAME
                            </td>
                            <td class="confirm-cell"><span class='badge bg-danger'>Chưa có thẻ</span></td>
                            <td class="text-center action-buttons">
                                <!-- Nút in thẻ đơn -->
                                <button type="button" class="btn btn-sm btn-info ms-1 mb-1 js-print-single"
                                        data-employee-id="@emp.ID"
                                        data-confirm-title="In thẻ"
                                        data-confirm-message="Bạn có chắc chắn muốn in thẻ cho nhân viên này?">
                                    <i class="fa-solid fa-print"></i> In
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-2">
        <div class="small text-muted">Hiển thị @startIndex - @endIndex / @Model.TotalCount</div>
        @await Html.PartialAsync("_Pagination", new
        {
            PageIndex = Model.PageNumber,
                TotalPages = Model.TotalPages,
                PageSize = Model.PageSize,
                Action = "NotCard",
                Term = (string?)null,
                RouteExtras = new Dictionary<string, string?>
                {
                    ["employeeId"] = Model.EmployeeId,
                    ["department"] = Model.Department
                }
        })
    </div>
</div>

@section Scripts {
    <script src="~/js/cardcar/card-not.js" asp-append-version="true"></script>
}