@using BusManagement.Model

@model UsingCardViewModel
@{
    ViewData["Title"] = "Thẻ sử dụng xe đi làm";
    var sections = ViewBag.Sections as IEnumerable<BusManagement.Model.Dtos.TM_SECTIONDTO> ?? Enumerable.Empty<BusManagement.Model.Dtos.TM_SECTIONDTO>();
    var startIndex = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize + 1);
    var endIndex = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

<style>
    .using-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
    }
    .using-card .table thead th {
        white-space: nowrap;
        vertical-align: middle;
        text-align: center;
    }
    .using-actions .btn {
        min-width: 110px;
    }
    .confirm-cell {
        color: #15803d;
        font-weight: 600;
        text-align: center;
    }
    .table-checkbox { width: 40px; }
    .action-buttons .btn { min-width: 60px; }
</style>

<div class="using-card p-3 p-md-4"
     data-getBus-url="@Url.Action("GetActiveBuses", "CardCar")"
     data-getBusStop-url="@Url.Action("GetActiveBusStops", "CardCar")"
     data-getUpdateCard-url="@Url.Action("UpdateCardBus", "CardCar")">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <div>
            <h5 class="m-0">Quản lý thẻ sử dụng xe đi làm</h5>
            <div class="small text-muted">Tra cứu và cập nhật danh sách công nhân viên đã có thẻ</div>
        </div>
        <button id="btnBulkDelete" type="button" class="btn btn-danger d-none"
                data-form-id="bulkDeleteForm"
                data-confirm-title="Xóa nhiều thẻ"
                data-confirm-message="Bạn có chắc chắn muốn xóa các thẻ đã chọn?"
                data-require-selection="1"
                disabled>
            <i class="fa-solid fa-trash-can me-1"></i>Xóa đã chọn
        </button>
    </div>

    <form method="get" asp-controller="CardCar" asp-action="CardUsingCar" class="row g-2 mb-3 js-search-form">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="col-12 col-md-6 col-lg-3">
            <input class="form-control" name="employeeId" value="@Model.EmployeeId" placeholder="Mã nhân viên" />
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <select class="form-select" name="department">
                <option value="">Tất cả phòng ban</option>
                @foreach (var sec in sections)
                {
                    if (Model.Department == sec.CHR_CODE)
                    {
                        <option value="@sec.CHR_CODE" selected>@sec.CHR_NAME</option>
                    }
                    else
                    {
                        <option value="@sec.CHR_CODE">@sec.CHR_NAME</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-3 d-grid d-md-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass me-1"></i>Tìm kiếm</button>
            <button type="button" class="btn btn-secondary js-btn-reset"><i class="fa-solid fa-rotate-right me-1"></i>Làm mới</button>
        </div>
    </form>

    <form id="bulkDeleteForm" method="post" asp-controller="CardCar" asp-action="DeleteCards"
          class="js-confirm js-require-selection"
          data-confirm-title="Xóa nhiều thẻ"
          data-confirm-message="Bạn có chắc chắn muốn xóa các thẻ đã chọn?">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
        <input type="hidden" name="department" value="@Model.Department" />
        <input type="hidden" name="page" value="@Model.PageNumber" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="table-checkbox"><input id="chkAll" type="checkbox" class="form-check-input" /></th>
                    <th width="60">STT</th>
                    <th>Mã nhân viên</th>
                    <th>Phòng ban</th>
                    <th>Họ và tên</th>
                    <th>Số xe chiều đón và chiều về</th>
                    <th>Điểm đón/trả</th>
                    <th>Xác nhận</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Cards.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Không có dữ liệu thẻ sử dụng xe.</td>
                    </tr>
                }
                else
                {
                    var index = 0;
                    foreach (var card in Model.Cards)
                    {
                        var sectionName = sections
                                .FirstOrDefault(x => x.CHR_CODE == card.CHR_CODE_SEC)
                                ?.CHR_NAME ?? card.CHR_CODE_SEC;
                        index++;
                        var stt = (Model.PageNumber - 1) * Model.PageSize + index;

                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input js-card-check"
                                       name="ids" value="@card.ID" form="bulkDeleteForm" />
                            </td>
                            <td class="text-center">@stt</td>
                            <td>@card.CHR_EMPLOYEE_ID</td>
                            <td>@sectionName</td>
                            <td>@card.NVCHR_EMPLOYEE_NAME</td>
                            <td>@card.BusCode</td>
                            <td>@card.NVCHR_STOP_NAME</td>
                            <td class="confirm-cell"><span class='badge bg-success'>✔ Đã có thẻ </span></td>
                            <td class="text-center action-buttons">
                                <!-- Nút Sửa (mở modal) -->
                                <button type="button" class="btn btn-sm btn-primary ms-1 mb-1" 
                                        data-bs-toggle="modal" data-bs-target="#editCardModal-@card.ID">
                                    <i class="fa-solid fa-pen"></i> Sửa
                                </button>
                                <!-- Form xóa đơn -->
                                <form id="deleteCardForm-@card.ID" method="post" asp-controller="CardCar" asp-action="DeleteCard" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@card.ID" />
                                    <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                                    <input type="hidden" name="department" value="@Model.Department" />
                                    <input type="hidden" name="page" value="@Model.PageNumber" />
                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                    <button class="btn btn-sm btn-danger ms-1 mb-1 js-action-button" type="button"
                                            data-form-id="deleteCardForm-@card.ID"
                                            data-confirm-title="Xóa thẻ"
                                            data-confirm-message="Bạn có chắc chắn muốn xóa thẻ này?">
                                        <i class="fa-solid fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-2">
        <div class="small text-muted">Hiển thị @startIndex - @endIndex / @Model.TotalCount</div>
        @await Html.PartialAsync("_Pagination", new
        {
            PageIndex = Model.PageNumber,
            TotalPages = Model.TotalPages,
            PageSize = Model.PageSize,
            Action = "CardUsingCar",
            Term = (string?)null,
            RouteExtras = new Dictionary<string, string?>
            {
                ["employeeId"] = Model.EmployeeId,
                ["department"] = Model.Department
            }
        })
    </div>
</div>

<!-- Modal chỉnh sửa (lặp lại cho từng card) -->
@foreach (var card in Model.Cards)
{
    var sectionName = sections
        .FirstOrDefault(x => x.CHR_CODE == card.CHR_CODE_SEC)
        ?.CHR_NAME ?? card.CHR_CODE_SEC;
    <div class="modal fade dragable-modal" id="editCardModal-@card.ID" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Chỉnh sửa thẻ - @card.CHR_CARD_CODE</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-controller="CardCar" asp-action="UpdateCardBus" class="js-post-form">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="id" value="@card.ID" />
                        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                        <input type="hidden" name="department" value="@Model.Department" />
                        <input type="hidden" name="page" value="@Model.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Mã nhân viên</label>
                                <input class="form-control" name="EmployeeId" value="@card.CHR_EMPLOYEE_ID" required readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Phòng ban</label>
                                <input class="form-control" name="Department" value="@sectionName" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Họ và tên</label>
                                <input class="form-control" name="FullName" value="@card.NVCHR_EMPLOYEE_NAME" required readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Số xe</label>
                                <select class="form-select bus-number-select"
                                        name="BusNumber"
                                        data-selected="@card.INT_BUS_ID">
                                    <option value="">-- Chọn xe --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Điểm đón/trả</label>
                                <select class="form-select stop-point-select"
                                        name="StopPoint"
                                        data-selected="@card.INT_BUS_STOP_ID">
                                    <option value="">-- Chọn điểm đón/trả --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script src="~/js/cardcar/card-using.js" asp-append-version="true"></script>
}