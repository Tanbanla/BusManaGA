@model BusManagement.ViewModels.BusRequest.BusRequestApprovalPageViewModel
@{
    ViewData["Title"] = Model.StageTitle;
}

<style>
    .approval-card { border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; box-shadow: 0 10px 24px rgba(15, 23, 42, .05); }
    .bus-status-row-pending { background-color: #f3f4f6; }
    .bus-status-row-processing { background-color: #dbeafe; }
    .bus-status-row-approved { background-color: #dcfce7; }
    .bus-status-row-rejected { background-color: #fee2e2; }
    .lottie-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.25); display: none; align-items: center; justify-content: center; z-index: 2000; }
    .lottie-overlay.show { display: flex; }
    #approvalSuccessLottie { width: 280px; height: 280px; }
</style>

<div class="approval-card p-3 p-md-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <h5 class="m-0">@Model.StageTitle</h5>
        <a class="btn btn-outline-secondary" asp-controller="BusRequest" asp-action="Index">
            <i class="fa-solid fa-arrow-left me-1"></i>Về màn hình đăng ký/hủy xe
        </a>
    </div>

<div id="lottieOverlay" class="lottie-overlay">
    <div id="approvalSuccessLottie"></div>
</div>

    @if (!Model.CanProcess)
    {
        <div class="alert alert-warning mb-0">@Model.AccessDeniedMessage</div>
    }
    else
    {
        <form id="approvalActionForm" show-loading method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Stage" value="@Model.Stage" />
            <input type="hidden" name="SelectedIds" id="selectedIdsInput" />
            <input type="hidden" name="RejectReason" id="rejectReasonInput" />

            <div class="table-responsive mb-5 pb-5">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40px;"><input type="checkbox" class="request-check-all" id="checkAll" /></th>
                            <th>STT</th>
                            <th>Lịch sử</th>
                            <th>Trạng thái</th>
                            <th>Phòng ban</th>
                            <th>Mã nv</th>
                            <th>Họ tên</th>
                            <th>Chức vụ</th>
                            <th>Địa chỉ</th>
                            <th>Loại đơn</th>
                            <th>Tuyến xe</th>
                            <th>Điểm đón</th>
                            <th>Ngày sử dụng / Hủy xe</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Requests.Any())
                        {
                            <tr><td colspan="14" class="text-center text-muted py-4">Không có bản ghi chờ xử lý.</td></tr>
                        }
                        else
                        {
                            for (var i = 0; i < Model.Requests.Count; i++)
                            {
                                var item = Model.Requests[i];
                                <tr class="@item.StatusRowClass">
                                    <td><input type="checkbox" class="request-check" value="@item.Id" /></td>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-primary btn-sm js-history-btn"
                                                data-history-url="@Url.Action("History", "BusRequestApproval", new { id = item.Id, modal = true })"
                                                title="Xem lịch sử phê duyệt">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </button>
                                    </td>
                                    <td><span class="badge @item.StatusBadgeClass">@item.StatusText</span></td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.EmployeeCode</td>
                                    <td>@item.EmployeeName</td>
                                    <td>@item.Position</td>
                                    <td>@item.Address</td>
                                    <td>@item.RequestTypeName</td>
                                    <td>@item.RouteDisplay</td>
                                    <td>@item.BusStopDisplay</td>
                                    <td>@item.UseOrCancelDate?.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

<div class="modal fade dragable-modal" id="approvalHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử phê duyệt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="approvalHistoryModalBody"></div>
        </div>
    </div>
</div>

            <div class="approval-action-bar">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-danger px-3" onclick="openRejectModal();">
                        <i class="fa-solid fa-circle-xmark me-2"></i>Từ chối
                    </button>
                    <button type="submit" class="btn btn-success px-3"
                            formaction="@Url.Action("Approve", "BusRequestApproval")"
                            onclick="return prepareApprovalAction();">
                        <i class="fa-solid fa-circle-check me-2"></i>Xác nhận phê duyệt
                    </button>
                </div>
            </div>
        </form>
    }
</div>

<div class="modal fade" id="rejectReasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nhập lý do từ chối</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea id="rejectReasonText" class="form-control" rows="4" placeholder="Nhập lý do từ chối" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" onclick="submitReject();">Xác nhận từ chối</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["BusRequestApprovalSuccess"] is string successMessage)
    {
        <script>window.AppCommon && AppCommon.successTopRight(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)));</script>
    }
    @if (TempData["BusRequestApprovalError"] is string errorMessage)
    {
        <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));</script>
    }

    <script>
        (function () {
            var checkAll = document.getElementById('checkAll');
            var checkboxes = Array.prototype.slice.call(document.querySelectorAll('.request-check'));
            var tableBody = document.querySelector('#approvalActionForm .table tbody');

            function isInteractiveTarget(el) {
                return !!el.closest('a,button,input,select,textarea,label,.btn,[data-bs-toggle]');
            }

            if (checkAll) {
                checkAll.addEventListener('change', function () {
                    checkboxes.forEach(function (cb) { cb.checked = checkAll.checked; });
                });
            }

            if (tableBody) {
                tableBody.addEventListener('click', function (e) {
                    if (isInteractiveTarget(e.target)) return;

                    var row = e.target.closest('tr');
                    if (!row) return;

                    var rowCheckbox = row.querySelector('.request-check');
                    if (!rowCheckbox) return;

                    rowCheckbox.checked = !rowCheckbox.checked;
                });
            }

            window.prepareApprovalAction = function () {
                var selected = checkboxes.filter(function (cb) { return cb.checked; }).map(function (cb) { return cb.value; });
                if (!selected.length) {
                    window.AppCommon && AppCommon.error('Vui lòng chọn ít nhất 1 bản ghi.');
                    return false;
                }

                document.getElementById('selectedIdsInput').value = selected.join(',');
                document.getElementById('rejectReasonInput').value = '';
                return true;
            };

            window.openRejectModal = function () {
                if (!window.prepareApprovalAction()) return;

                var modalEl = document.getElementById('rejectReasonModal');
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            };

            window.submitReject = function () {
                var reason = (document.getElementById('rejectReasonText').value || '').trim();
                if (!reason) {
                    window.AppCommon && AppCommon.error('Vui lòng nhập lý do từ chối.');
                    return;
                }

                document.getElementById('rejectReasonInput').value = reason;
                var modalEl = document.getElementById('rejectReasonModal');
                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.hide();

                var form = document.getElementById('approvalActionForm');
                form.action = '@Url.Action("Reject", "BusRequestApproval")';
                form.submit();
            };

            var historyModalEl = document.getElementById('approvalHistoryModal');
            var historyModalBody = document.getElementById('approvalHistoryModalBody');
            if (historyModalEl && historyModalBody) {
                var historyModal = bootstrap.Modal.getOrCreateInstance(historyModalEl);
                document.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.js-history-btn');
                    if (!btn) return;

                    var url = btn.getAttribute('data-history-url');
                    if (!url) return;

                    historyModalBody.innerHTML = '<div class="text-center text-muted py-4">Đang tải...</div>';
                    historyModal.show();

                    try {
                        var response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (!response.ok) throw new Error('Load history failed');
                        historyModalBody.innerHTML = await response.text();
                    } catch {
                        historyModalBody.innerHTML = '<div class="alert alert-danger mb-0">Không thể tải lịch sử phê duyệt.</div>';
                    }
                });
            }

            var shouldCelebrate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["BusRequestApprovalCelebrate"] != null));
            if (shouldCelebrate && window.lottie) {
                var overlay = document.getElementById('lottieOverlay');
                var container = document.getElementById('approvalSuccessLottie');
                if (overlay && container) {
                    overlay.classList.add('show');
                    container.innerHTML = '';
                    lottie.loadAnimation({
                        container: container,
                        renderer: 'svg',
                        loop: false,
                        autoplay: true,
                        path: '/lotties/congratulations_smiley.json'
                    });

                    setTimeout(function () {
                        overlay.classList.remove('show');
                    }, 2500);
                }
            }
        })();
    </script>
}
