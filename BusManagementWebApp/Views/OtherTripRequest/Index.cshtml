@using BusManagement.Model.Common.Enum
@model BusManagement.ViewModels.TripRequest.TripRequestPageViewModel
@{
    ViewData["Title"] = "Đăng ký xe khác";
    var startIndex = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize + 1);
    var endIndex = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

<style>
    .trip-card { border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; box-shadow: 0 10px 24px rgba(15, 23, 42, .05); }
    .bus-status-row-pending { background-color: #f3f4f6; }
    .bus-status-row-processing { background-color: #dbeafe; }
    .bus-status-row-approved { background-color: #dcfce7; }
    .bus-status-row-rejected { background-color: #fee2e2; }
    #createOtherTripRequestModal .modal-body,
    [id^="editOtherTripRequestModal-"] .modal-body,
    #approvalHistoryModal .modal-body { max-height: 70vh; overflow-y: auto; }
    .lottie-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.25); display: none; align-items: center; justify-content: center; z-index: 2000; }
    .lottie-overlay.show { display: flex; }
    #approvalSuccessLottie { width: 280px; height: 280px; }
</style>

<div class="trip-card p-3 p-md-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <h5 class="m-0">Đăng ký xe khác</h5>
            <button type="button" class="btn btn-lg btn-primary" data-bs-toggle="modal" data-bs-target="#createOtherTripRequestModal"><i class="fa-solid fa-plus me-1"></i>Đăng ký mới</button>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <form method="get" asp-controller="OtherTripRequest" asp-action="Export" class="d-inline">
                <input type="hidden" name="department" value="@Model.Department" />
                <input type="hidden" name="employeeCode" value="@Model.EmployeeCode" />
                <input type="hidden" name="employeeName" value="@Model.EmployeeName" />
                <input type="hidden" name="phone" value="@Model.Phone" />
                <input type="hidden" name="status" value="@Model.Status" />
                <input type="hidden" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-success"><i class="fa-solid fa-file-excel me-1"></i>Xuất Excel</button>
            </form>
            @if (Model.CanManageAll)
            {
                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#importOtherTripRequestModal"><i class="fa-solid fa-file-import me-1"></i>Import</button>
            }
        </div>
    </div>

    <form method="get" show-loading asp-controller="OtherTripRequest" asp-action="Index" class="row g-2 mb-3">
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="col-md-2"><input class="form-control" name="department" value="@Model.Department" placeholder="Phòng ban" /></div>
        <div class="col-md-2"><input class="form-control" name="employeeCode" value="@Model.EmployeeCode" placeholder="MNV" /></div>
        <div class="col-md-2"><input class="form-control" name="employeeName" value="@Model.EmployeeName" placeholder="Họ tên" /></div>
        <div class="col-md-2"><input class="form-control" name="phone" value="@Model.Phone" placeholder="SĐT" /></div>
        <div class="col-md-2">
            <select class="form-select" name="status">
                <option value="">Trạng thái</option>
                <option value="0" selected="@(Model.Status == TripRequestStatuses.PendingQlsc)">Chờ GA điền lái xe</option>
                <option value="8" selected="@(Model.Status == TripRequestStatuses.Completed)">Hoàn thành</option>
            </select>
        </div>
        <div class="col-md-2"><input type="date" class="form-control" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><input type="date" class="form-control" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-1 d-grid"><button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i></button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th rowspan="2" class="text-center align-middle text-nowrap">Thao tác</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">STT</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">MNV</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">Phòng ban</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">Họ tên</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">SĐT</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">Loại đơn</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">Trạng thái</th>
                    <th colspan="4" class="text-center align-middle text-nowrap">Chiều đi</th>
                    <th colspan="4" class="text-center align-middle text-nowrap">Chiều về</th>
                    <th rowspan="2" class="text-center align-middle text-nowrap">Thông tin lái xe</th>
                </tr>
                <tr>
                    <th class="text-center text-nowrap">Ngày đón</th>
                    <th class="text-center text-nowrap">Giờ đón</th>
                    <th class="text-center text-nowrap">Đón từ điểm</th>
                    <th class="text-center text-nowrap">Tới điểm</th>
                    <th class="text-center text-nowrap">Ngày đón</th>
                    <th class="text-center text-nowrap">Giờ đón</th>
                    <th class="text-center text-nowrap">Đón từ điểm</th>
                    <th class="text-center text-nowrap">Tới điểm</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Requests.Any())
                {
                    <tr><td colspan="17" class="text-center text-muted">Không có dữ liệu.</td></tr>
                }
                else
                {
                    for (var i = 0; i < Model.Requests.Count; i++)
                    {
                        var item = Model.Requests[i];
                        <tr class="@item.StatusRowClass">
                            <td class="text-center">
                                <button type="button" class="btn btn-primary btn-sm js-history-btn mb-1" data-history-url="@Url.Action("History", "OtherTripRequestApproval", new { id = item.Id, modal = true })"><i class="fa-solid fa-clock-rotate-left"></i></button>
                                @if (item.CanEdit)
                                {
                                    <button type="button" class="btn btn-warning btn-sm mb-1" data-bs-toggle="modal" data-bs-target="#editOtherTripRequestModal-@item.Id"><i class="fa-solid fa-pen"></i></button>
                                }
                                @if (item.CanDelete)
                                {
                                    <form method="post" show-loading asp-controller="OtherTripRequest" asp-action="Delete" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="SearchDepartment" value="@Model.Department" />
                                        <input type="hidden" name="SearchEmployeeCode" value="@Model.EmployeeCode" />
                                        <input type="hidden" name="SearchEmployeeName" value="@Model.EmployeeName" />
                                        <input type="hidden" name="SearchPhone" value="@Model.Phone" />
                                        <input type="hidden" name="SearchStatus" value="@Model.Status" />
                                        <input type="hidden" name="SearchDateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="SearchDateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="Page" value="@Model.PageNumber" />
                                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                        <button type="submit" class="btn btn-danger btn-sm mb-1"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                }
                            </td>
                            <td>@(startIndex + i)</td>
                            <td>@item.EmployeeCode</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.Phone</td>
                            <td>@item.TripType</td>
                            <td><span class="badge @item.StatusBadgeClass">@item.StatusText</span></td>
                            <td>@item.PickupGo?.ToString("dd/MM/yyyy")</td>
                            <td>@item.PickupGo?.ToString("HH:mm")</td>
                            <td>@item.FromGo</td>
                            <td>@item.ToGo</td>
                            <td>@item.PickupReturn?.ToString("dd/MM/yyyy")</td>
                            <td>@item.PickupReturn?.ToString("HH:mm")</td>
                            <td>@item.FromReturn</td>
                            <td>@item.ToReturn</td>
                            <td style="white-space: pre-line; min-width: 220px;">@item.DriverInfo</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="small text-muted mb-2">Hiển thị @startIndex - @endIndex / @Model.TotalCount</div>
    @await Html.PartialAsync("_Pagination", new
    {
        PageIndex = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        Action = "Index",
        Controller = "OtherTripRequest",
        Term = (string?)null,
        RouteExtras = new Dictionary<string, string?>
        {
            ["department"] = Model.Department,
            ["employeeCode"] = Model.EmployeeCode,
            ["employeeName"] = Model.EmployeeName,
            ["phone"] = Model.Phone,
            ["status"] = Model.Status?.ToString(),
            ["dateFrom"] = Model.DateFrom?.ToString("yyyy-MM-dd"),
            ["dateTo"] = Model.DateTo?.ToString("yyyy-MM-dd")
        }
    })
</div>

<div class="modal fade" id="approvalHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Lịch sử xử lý</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="approvalHistoryModalBody"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="createOtherTripRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Đăng ký xe khác</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form method="post" show-loading asp-controller="OtherTripRequest" asp-action="Create" class="js-trip-form" data-trip-mode="create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="SearchDepartment" value="@Model.Department" />
                    <input type="hidden" name="SearchEmployeeCode" value="@Model.EmployeeCode" />
                    <input type="hidden" name="SearchEmployeeName" value="@Model.EmployeeName" />
                    <input type="hidden" name="SearchPhone" value="@Model.Phone" />
                    <input type="hidden" name="SearchStatus" value="@Model.Status" />
                    <input type="hidden" name="SearchDateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="SearchDateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Page" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />

                    <div class="row g-3">
                        <div class="col-12"><h6>Thông tin CNV đăng ký</h6></div>
                        <div class="col-md-4"><label class="form-label">MNV</label><input class="form-control js-employee-code-autofill" name="EmployeeCode" value="@Model.CurrentEmployeeCode" required /></div>
                        <div class="col-md-4"><label class="form-label">Họ tên</label><input class="form-control" name="EmployeeName" value="@Model.CurrentEmployeeName" readonly /></div>
                        <div class="col-md-4"><label class="form-label">Phòng ban</label><input class="form-control js-department-name" name="DepartmentName" readonly /></div>
                        <input type="hidden" name="DepartmentCode" value="@Model.CurrentDepartmentCode" />
                        <div class="col-md-4"><label class="form-label">SĐT</label><input class="form-control" name="Phone" /></div>
                        <div class="col-md-4">
                            <label class="form-label">Loại đơn</label>
                            <select class="form-select" name="TripType" required>
                                <option value="">-- Chọn loại đơn --</option>
                                @foreach (var requestType in Model.RequestTypeNames)
                                {
                                    <option value="@requestType">@requestType</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-info py-2 mb-0 d-none js-route-suggestion"></div>
                        </div>

                        <div class="col-12 d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Thông tin lộ trình</h6>
                            <button type="button" class="btn btn-outline-secondary btn-sm js-swap-route">
                                <i class="fa-solid fa-right-left me-1"></i>Đảo ngược điểm đón/trả
                            </button>
                        </div>

                        <div class="col-12">
                            <div class="border rounded p-3 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 text-primary">Chiều đi</h6>
                                    <button type="button" class="btn btn-outline-danger btn-sm js-clear-direction" data-direction="go">
                                        <i class="fa-solid fa-eraser me-1"></i>Xóa dữ liệu chiều đi
                                    </button>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-3"><label class="form-label">Ngày đón</label><input type="date" class="form-control" name="PickupGoDate" required /></div>
                                    <div class="col-md-3"><label class="form-label">Giờ đón</label><input type="time" class="form-control" name="PickupGoTime" required /></div>
                                    <div class="col-md-3"><label class="form-label">Đón từ điểm</label><textarea class="form-control" name="FromGo" rows="2" required></textarea></div>
                                    <div class="col-md-3"><label class="form-label">Tới điểm</label><textarea class="form-control" name="ToGo" rows="2" required></textarea></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="border rounded p-3 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 text-success">Chiều về (nếu có)</h6>
                                    <button type="button" class="btn btn-outline-danger btn-sm js-clear-direction" data-direction="return">
                                        <i class="fa-solid fa-eraser me-1"></i>Xóa dữ liệu chiều về
                                    </button>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-3"><label class="form-label">Ngày đón</label><input type="date" class="form-control" name="PickupReturnDate" /></div>
                                    <div class="col-md-3"><label class="form-label">Giờ đón</label><input type="time" class="form-control" name="PickupReturnTime" /></div>
                                    <div class="col-md-3"><label class="form-label">Đón từ điểm</label><textarea class="form-control" name="FromReturn" rows="2"></textarea></div>
                                    <div class="col-md-3"><label class="form-label">Tới điểm</label><textarea class="form-control" name="ToReturn" rows="2"></textarea></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-primary">Đăng ký</button></div>
            </form>
        </div>
    </div>
</div>

@foreach (var item in Model.Requests.Where(x => x.CanEdit))
{
    <div class="modal fade" id="editOtherTripRequestModal-@item.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Cập nhật đơn #@item.Id</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form method="post" show-loading asp-controller="OtherTripRequest" asp-action="Update" class="js-trip-form" data-trip-mode="edit">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="Id" value="@item.Id" />
                        <input type="hidden" name="SearchDepartment" value="@Model.Department" />
                        <input type="hidden" name="SearchEmployeeCode" value="@Model.EmployeeCode" />
                        <input type="hidden" name="SearchEmployeeName" value="@Model.EmployeeName" />
                        <input type="hidden" name="SearchPhone" value="@Model.Phone" />
                        <input type="hidden" name="SearchStatus" value="@Model.Status" />
                        <input type="hidden" name="SearchDateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="SearchDateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="Page" value="@Model.PageNumber" />
                        <input type="hidden" name="PageSize" value="@Model.PageSize" />

                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label">MNV</label><input class="form-control js-employee-code-autofill" name="EmployeeCode" value="@item.EmployeeCode" required /></div>
                            <div class="col-md-4"><label class="form-label">Họ tên</label><input class="form-control" name="EmployeeName" value="@item.EmployeeName" required /></div>
                            <div class="col-md-4"><label class="form-label">Phòng ban</label><input class="form-control js-department-name" name="DepartmentName" value="@item.DepartmentName" readonly /></div>
                            <input type="hidden" name="DepartmentCode" value="@item.DepartmentCode" />
                            <div class="col-md-4"><label class="form-label">SĐT</label><input class="form-control" name="Phone" value="@item.Phone" /></div>
                            <div class="col-md-4">
                                <label class="form-label">Loại đơn</label>
                                <select class="form-select" name="TripType" required>
                                    @foreach (var requestType in Model.RequestTypeNames)
                                    {
                                        if (string.Equals(item.TripType, requestType, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@requestType" selected>@requestType</option>
                                        }
                                        else
                                        {
                                            <option value="@requestType">@requestType</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="alert alert-info py-2 mb-0 d-none js-route-suggestion"></div>
                            </div>
                            <div class="col-12 d-flex justify-content-end">
                                <button type="button" class="btn btn-outline-secondary btn-sm js-swap-route">
                                    <i class="fa-solid fa-right-left me-1"></i>Đảo ngược điểm đón/trả
                                </button>
                            </div>

                            <div class="col-12">
                                <div class="border rounded p-3 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0 text-primary">Chiều đi</h6>
                                        <button type="button" class="btn btn-outline-danger btn-sm js-clear-direction" data-direction="go">
                                            <i class="fa-solid fa-eraser me-1"></i>Xóa dữ liệu chiều đi
                                        </button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-3"><label class="form-label">Ngày đón đi</label><input type="date" class="form-control" name="PickupGoDate" value="@item.PickupGo?.ToString("yyyy-MM-dd")" required /></div>
                                        <div class="col-md-3"><label class="form-label">Giờ đón đi</label><input type="time" class="form-control" name="PickupGoTime" value="@item.PickupGo?.ToString("HH:mm")" required /></div>
                                        <div class="col-md-3"><label class="form-label">Đón từ điểm đi</label><textarea class="form-control" name="FromGo" rows="2" required>@item.FromGo</textarea></div>
                                        <div class="col-md-3"><label class="form-label">Tới điểm đi</label><textarea class="form-control" name="ToGo" rows="2" required>@item.ToGo</textarea></div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="border rounded p-3 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0 text-success">Chiều về (nếu có)</h6>
                                        <button type="button" class="btn btn-outline-danger btn-sm js-clear-direction" data-direction="return">
                                            <i class="fa-solid fa-eraser me-1"></i>Xóa dữ liệu chiều về
                                        </button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-3"><label class="form-label">Ngày đón về</label><input type="date" class="form-control" name="PickupReturnDate" value="@item.PickupReturn?.ToString("yyyy-MM-dd")" /></div>
                                        <div class="col-md-3"><label class="form-label">Giờ đón về</label><input type="time" class="form-control" name="PickupReturnTime" value="@item.PickupReturn?.ToString("HH:mm")" /></div>
                                        <div class="col-md-3"><label class="form-label">Đón từ điểm về</label><textarea class="form-control" name="FromReturn" rows="2">@item.FromReturn</textarea></div>
                                        <div class="col-md-3"><label class="form-label">Tới điểm về</label><textarea class="form-control" name="ToReturn" rows="2">@item.ToReturn</textarea></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-primary">Lưu</button></div>
                </form>
            </div>
        </div>
    </div>
}

<div id="lottieOverlay" class="lottie-overlay">
    <div id="approvalSuccessLottie"></div>
</div>

@if (Model.CanManageAll)
{
    <div class="modal fade" id="importOtherTripRequestModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Import đơn xe khác</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <form method="post" show-loading asp-controller="OtherTripRequest" asp-action="Import" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="department" value="@Model.Department" />
                        <input type="hidden" name="employeeCode" value="@Model.EmployeeCode" />
                        <input type="hidden" name="employeeName" value="@Model.EmployeeName" />
                        <input type="hidden" name="phone" value="@Model.Phone" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="page" value="@Model.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="file" name="importFile" class="form-control" accept=".xlsx,.csv" required />
                        <div class="small text-muted mt-2">Định dạng: STT,MNV,Phòng ban,Họ tên,SĐT,Ngày đi,Giờ đi,Điểm đón đi,Điểm tới đi,Ngày về,Giờ về,Điểm đón về,Điểm tới về</div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-success">Import</button></div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (TempData["OtherTripRequestSuccess"] is string s) { <script>window.AppCommon && AppCommon.successTopRight(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s)));</script> }
    @if (TempData["OtherTripRequestError"] is string e) { <script>window.AppCommon && AppCommon.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(e)));</script> }

    <script>
        (function(){
            function isWorkingDay(date) {
                var day = date.getDay();
                return day >= 1 && day <= 5;
            }

            function isBusinessHours(date) {
                var hour = date.getHours();
                var minute = date.getMinutes();
                var totalMinutes = hour * 60 + minute;
                var start = 8 * 60;
                var end = 17 * 60;
                return totalMinutes >= start && totalMinutes < end;
            }

            function getRecommendedRoute(data) {
                var bivnPoint = (data && data.suggestedPickupFromBivn ? data.suggestedPickupFromBivn : '').trim();
                var homePoint = (data && data.suggestedAddress ? data.suggestedAddress : '').trim();
                if (!bivnPoint && !homePoint) return null;

                var now = new Date();
                var inOfficeTime = isWorkingDay(now) && isBusinessHours(now);

                return inOfficeTime
                    ? { from: bivnPoint || homePoint, to: homePoint || bivnPoint, inOfficeTime: true }
                    : { from: homePoint || bivnPoint, to: bivnPoint || homePoint, inOfficeTime: false };
            }

            function applyRouteSuggestion(form, data) {
                if (!form) return;

                var route = getRecommendedRoute(data);
                var hint = form.querySelector('.js-route-suggestion');
                if (!route) {
                    if (hint) {
                        hint.classList.add('d-none');
                        hint.textContent = '';
                    }
                    return;
                }

                var mode = (form.dataset.tripMode || 'create').toLowerCase();
                var fromGo = form.querySelector('[name="FromGo"]');
                var toGo = form.querySelector('[name="ToGo"]');
                var fromReturn = form.querySelector('[name="FromReturn"]');
                var toReturn = form.querySelector('[name="ToReturn"]');

                var shouldForce = mode === 'create';
                if (fromGo && (shouldForce || !(fromGo.value || '').trim())) fromGo.value = route.to;
                if (toGo && (shouldForce || !(toGo.value || '').trim())) toGo.value = route.from;
                if (fromReturn && (shouldForce || !(fromReturn.value || '').trim())) fromReturn.value = route.from;
                if (toReturn && (shouldForce || !(toReturn.value || '').trim())) toReturn.value = route.to;

                var pickupGoDate = form.querySelector('input[name="PickupGoDate"]');
                var pickupReturnDate = form.querySelector('input[name="PickupReturnDate"]');
                var now = new Date();
                var yyyy = now.getFullYear();
                var mm = String(now.getMonth() + 1).padStart(2, '0');
                var dd = String(now.getDate()).padStart(2, '0');
                var today = yyyy + '-' + mm + '-' + dd;

                if (pickupGoDate) pickupGoDate.value = today;
                if (pickupReturnDate) pickupReturnDate.value = today;

                if (hint) {
                    hint.classList.remove('d-none');
                    hint.textContent = route.inOfficeTime
                        ? 'Gợi ý theo giờ hành chính: Điểm đón = BIVN, Điểm trả = Địa chỉ nhà.'
                        : 'Gợi ý ngoài giờ hành chính: Điểm đón = Địa chỉ nhà, Điểm trả = BIVN.';
                }
            }

            function swapRoutePoints(form) {
                if (!form) return;

                function swap(aName, bName) {
                    var a = form.querySelector('[name="' + aName + '"]');
                    var b = form.querySelector('[name="' + bName + '"]');
                    if (!a || !b) return;
                    var temp = a.value;
                    a.value = b.value;
                    b.value = temp;
                }

                swap('FromGo', 'ToGo');
                swap('FromReturn', 'ToReturn');
            }

            function clearDirection(form, direction) {
                if (!form || !direction) return;

                var targets = direction === 'go'
                    ? ['PickupGoDate', 'PickupGoTime', 'FromGo', 'ToGo']
                    : ['PickupReturnDate', 'PickupReturnTime', 'FromReturn', 'ToReturn'];

                targets.forEach(function (name) {
                    var input = form.querySelector('[name="' + name + '"]');
                    if (!input) return;
                    input.value = '';
                });
            }

            async function resolveEmployeeInfo(form){
                var codeInput = form.querySelector('input[name="EmployeeCode"]');
                if (!codeInput) return;
                var code = (codeInput.value || '').trim();
                if (!code) return;

                var response = await fetch('@Url.Action("ResolveEmployeeByCode", "OtherTripRequest")?employeeCode=' + encodeURIComponent(code));
                if (!response.ok) return;
                var result = await response.json();
                if (!result || !result.success || !result.data) return;

                var employeeNameInput = form.querySelector('input[name="EmployeeName"]');
                var phoneInput = form.querySelector('input[name="Phone"]');
                var departmentCodeInput = form.querySelector('input[name="DepartmentCode"]');
                var departmentNameInput = form.querySelector('input[name="DepartmentName"]');

                if (employeeNameInput) employeeNameInput.value = result.data.employeeName || '';
                if (phoneInput) phoneInput.value = result.data.phone || '';
                if (departmentCodeInput) departmentCodeInput.value = result.data.departmentCode || '';
                if (departmentNameInput) departmentNameInput.value = result.data.departmentName || '';

                applyRouteSuggestion(form, result.data);
            }

            document.addEventListener('blur', function(e){
                var input = e.target.closest('.js-employee-code-autofill');
                if (!input) return;
                var form = input.closest('form');
                if (!form) return;
                resolveEmployeeInfo(form);
            }, true);

            document.querySelectorAll('.js-trip-form').forEach(function(form){ resolveEmployeeInfo(form); });

            document.addEventListener('click', function(e){
                var btn = e.target.closest('.js-swap-route');
                if (!btn) return;
                var form = btn.closest('form');
                if (!form) return;
                swapRoutePoints(form);
            });

            document.addEventListener('click', function(e){
                var btn = e.target.closest('.js-clear-direction');
                if (!btn) return;
                var form = btn.closest('form');
                if (!form) return;
                clearDirection(form, (btn.dataset.direction || '').toLowerCase());
            });

            var historyModalEl = document.getElementById('approvalHistoryModal');
            var historyModalBody = document.getElementById('approvalHistoryModalBody');
            if (historyModalEl && historyModalBody) {
                var historyModal = bootstrap.Modal.getOrCreateInstance(historyModalEl);
                document.addEventListener('click', async function (e) {
                    var btn = e.target.closest('.js-history-btn');
                    if (!btn) return;

                    historyModalBody.innerHTML = '<div class="text-center text-muted py-4">Đang tải...</div>';
                    historyModal.show();

                    try {
                        var response = await fetch(btn.getAttribute('data-history-url'), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (!response.ok) throw new Error('Load history failed');
                        historyModalBody.innerHTML = await response.text();
                    } catch {
                        historyModalBody.innerHTML = '<div class="alert alert-danger mb-0">Không thể tải lịch sử xử lý.</div>';
                    }
                });
            }

            var shouldCelebrate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["OtherTripRequestCelebrate"] != null));
            if (shouldCelebrate && window.lottie) {
                var overlay = document.getElementById('lottieOverlay');
                var container = document.getElementById('approvalSuccessLottie');
                if (overlay && container) {
                    overlay.classList.add('show');
                    container.innerHTML = '';
                    lottie.loadAnimation({
                        container: container,
                        renderer: 'svg',
                        loop: false,
                        autoplay: true,
                        path: '/lotties/congratulations_smiley.json'
                    });
                    setTimeout(function () { overlay.classList.remove('show'); }, 2500);
                }
            }
        })();
    </script>
}
